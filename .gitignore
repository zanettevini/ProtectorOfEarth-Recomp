# =====================================================================
# NEVER version anything that came off the disc, or anything generated from it.
# This repository only holds the project's OWN code and notes.
# Everyone builds the port from their own copy of the game.
# (AGENTS.md s.2)
# =====================================================================

# Disc images
*.iso
*.bin
*.cue
*.chd
*.cso

# Files taken from the disc: the ELF, the IRX, GAME.DIR/GAME.WAD...
/game/
/iso/
/ISO/
SLUS_*
SLES_*
*.IRX
*.irx

# PS2 BIOS (only for the PCSX2 reference; the port does not use it)
/bios/
*.rom0
*.nvm
*.mec

# Everything in generated/ comes from the game binary:
#   generated/default/  the C++ generated by ps2_recomp (it is the game's code)
#   generated/ghidra/   the function CSV and the Ghidra project
# Only the README, which explains the folder, is versioned.
/generated/*
!/generated/README.md

# Builds
/out/
/build/
cmake-build-*/
CMakeUserPresets.json
/compile_commands.json
/.cache/

# Player files when running from the source tree: saves, memory cards,
# settings, logs. Never in the repository.
/user/
/logs/
/captures/

# Raw captures and dumps (frames, memory, GS)
*.ppm
*.dmp
*.gs
*.p2s

# Ghidra project (contains the game binary)
*.gpr
*.rep/

# Scratch local
__pycache__/
*.pyc
/notes/
/CLAUDE.md

# Editors
.vs/
.vscode/
.idea/
*.swp
