{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, game, no optimisation (fastest build)",
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0",
        "CMAKE_C_FLAGS_DEBUG": "-O0",
        "BEN10_BUILD_GAME": "ON",
        "BEN10_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux, tests only",
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0",
        "BEN10_BUILD_GAME": "OFF",
        "BEN10_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows (MSVC), game. Run from the Developer PowerShell for VS 2022",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "BEN10_BUILD_GAME": "ON",
        "BEN10_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-tests",
      "displayName": "Windows (MSVC), tests only",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "BEN10_BUILD_GAME": "OFF",
        "BEN10_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug",   "jobs": 4 },
    { "name": "linux-tests",   "configurePreset": "linux-tests" },
    { "name": "windows-debug", "configurePreset": "windows-debug", "jobs": 4 },
    { "name": "windows-tests", "configurePreset": "windows-tests" }
  ],
  "testPresets": [
    { "name": "linux-tests",   "configurePreset": "linux-tests",   "output": { "outputOnFailure": true } },
    { "name": "windows-tests", "configurePreset": "windows-tests", "output": { "outputOnFailure": true } }
  ]
}
