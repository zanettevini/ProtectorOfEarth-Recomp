+void PS2Runtime::limitGuestHeapBelow(uint32_t guestAddr)
+{
+    // The heap must stop where the main thread's stack starts (SetupThread
+    // with stack = -1 puts that stack at the top of RAM).
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    const uint32_t limit = std::min(guestAddr & ~(kGuestHeapDefaultAlignment - 1u), PS2_RAM_SIZE);
+    if (limit == 0u)
+    {
+        return;
+    }
+    m_guestHeapHardLimit = limit;
+    if (m_guestHeapLimit > limit)
+    {
+        m_guestHeapLimit = limit;
+    }
+}
