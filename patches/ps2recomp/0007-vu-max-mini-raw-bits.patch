+        tc.Run("MAX and MINI move raw bit patterns without flushing denormals", [](TestCase &t)
+        {
+            // Games copy integer data with "MAX.xyzw vfA, vfB, vfB" (Ben 10
+            // moves its vertex colours into the GIF packet that way). Small
+            // integers are denormal float patterns: they must pass unchanged.
+            Vu1Fixture fx;
+            t.IsTrue(fx.initialize(), "VU1 fixture should initialize");
+
+            writeVuInstructionPair(fx.code, 0u, 0u, makeVuUpper(0x2Bu, 0xFu, 7u, 7u, 9u));  // MAX.xyzw vf9, vf7, vf7
+            writeVuInstructionPair(fx.code, 8u, 0u, makeVuUpper(0x2Fu, 0xFu, 6u, 5u, 10u)); // MINI.xyzw vf10, vf5, vf6
+
+            VU1Interpreter vu1;
+            const int32_t colour[4] = {103, 86, 66, 128};
+            std::memcpy(vu1.state().vf[7], colour, sizeof(colour));
+            const float a[4] = {-2.0f, 3.0f, -0.5f, 0.0f};
+            const float b[4] = {-1.0f, 4.0f, 0.25f, -0.0f};
+            std::memcpy(vu1.state().vf[5], a, sizeof(a));
+            std::memcpy(vu1.state().vf[6], b, sizeof(b));
+            vu1.execute(fx.code, PS2_VU1_CODE_SIZE,
+                        fx.data, PS2_VU1_DATA_SIZE, fx.gs, &fx.mem,
+                        0u, 0u, 0u, 8u);
+
+            int32_t moved[4];
+            std::memcpy(moved, vu1.state().vf[9], sizeof(moved));
+            t.Equals(moved[0], 103, "MAX must keep a denormal-looking integer pattern (x)");
+            t.Equals(moved[1], 86, "MAX must keep a denormal-looking integer pattern (y)");
+            t.Equals(moved[2], 66, "MAX must keep a denormal-looking integer pattern (z)");
+            t.Equals(moved[3], 128, "MAX must keep a denormal-looking integer pattern (w)");
+            t.Equals(vu1.state().vf[10][0], -2.0f, "MINI orders negative values");
+            t.Equals(vu1.state().vf[10][1], 3.0f, "MINI orders positive values");
+            t.Equals(vu1.state().vf[10][2], -0.5f, "MINI orders mixed signs");
+            uint32_t zeroBits = 0;
+            std::memcpy(&zeroBits, &vu1.state().vf[10][3], 4);
+            t.Equals(zeroBits, 0x80000000u, "MINI picks -0 below +0");
+        });
+
         tc.Run("MTIR decodes fsf as a component selector", [](TestCase &t)
         {
             Vu1Fixture fx;
