From: Protector of Earth Recomp
Subject: [PATCH] VU1 MAX/MINI: compare raw bits, do not flush denormals

What broke:
  In Ben 10's first level every textured model drawn by its VU1 programs
  came out black. The program copies the VIF-unpacked vertex colour (four
  small integers, e.g. 103, 86, 66, 128) into the GIF packet with
  "MAX.xyzw vf09, vf07, vf07". The interpreter ran MAX/MINI on operands
  passed through normalizeOperand, which flushes denormals to zero; those
  integers are denormal float patterns, so the colour became 0 and the
  textured triangles were drawn black (texture x vertex colour, alpha 0
  failing the alpha test with AFAIL = FB_ONLY).

Why:
  MAX and MINI are comparisons, not arithmetic: they return one of their
  operands unchanged and do not flush denormals, which is why the game can
  use "MAX vfA, vfB, vfB" as a move: the game's own code relies on it.
  (PCSX2's VU interpreter is believed to compare raw 32-bit values the same
  way; not re-checked against its source when this patch was written.)

The fix:
  MAXbc/MINIbc/MAXi/MINIi/MAX/MINI compare the raw bit patterns of the
  registers (sign-magnitude order: both negative -> the smaller integer is
  the larger float) and return the chosen operand's bits.
  New ps2xTest case: "MAX and MINI move raw bit patterns without flushing
  denormals" (fails before the fix, passes after).

How it was found:
  A gdb tally of GS draws in the level showed the textured triangles with
  vertex RGBA = 0; their GIF packets come from VU1 XGKICK. A dump of VU1
  micro memory, read with tools/analyzer/vu_disasm.py, showed the MAX move
  of the integer colour (findings/18 s.9).

diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
index 6974254..95d1440 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
@@ -16,6 +16,35 @@ namespace
             return std::numeric_limits<int32_t>::min();
         return static_cast<int32_t>(scaled);
     }
+
+    // MAX/MINI compare the raw 32-bit patterns, as sign-magnitude numbers
+    // (the order of IEEE floats), and return one operand unchanged. They do
+    // not flush denormals to zero like the arithmetic ops: games use
+    // "MAX.xyzw vfA, vfB, vfB" as a plain move of integer data (Ben 10 copies
+    // its VIF-unpacked vertex colours, small integers whose bit patterns are
+    // denormal floats, into the GIF packet that way; flushing them made every
+    // textured model black).
+    float vuRawMax(float a, float b)
+    {
+        int32_t ia, ib;
+        std::memcpy(&ia, &a, 4);
+        std::memcpy(&ib, &b, 4);
+        const int32_t r = (ia < 0 && ib < 0) ? (ia < ib ? ia : ib) : (ia > ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, 4);
+        return out;
+    }
+
+    float vuRawMin(float a, float b)
+    {
+        int32_t ia, ib;
+        std::memcpy(&ia, &a, 4);
+        std::memcpy(&ib, &b, 4);
+        const int32_t r = (ia < 0 && ib < 0) ? (ia > ib ? ia : ib) : (ia < ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, 4);
+        return out;
+    }
 }
 
 // ============================================================================
@@ -99,9 +128,10 @@ void VU1Interpreter::execUpper(uint32_t instr)
     case 0x12:
     case 0x13: // MAXbc
     {
-        float bc = broadcast(vt, op & 3);
+        // Raw operands, not the normalised copies (see vuRawMax).
+        const float bc = m_state.vf[ft][op & 3];
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] > bc) ? vs[c] : bc;
+            result[c] = vuRawMax(m_state.vf[fs][c], bc);
         applyDest(vd, result, dest);
         return;
     }
@@ -110,9 +140,9 @@ void VU1Interpreter::execUpper(uint32_t instr)
     case 0x16:
     case 0x17: // MINIbc
     {
-        float bc = broadcast(vt, op & 3);
+        const float bc = m_state.vf[ft][op & 3];
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] < bc) ? vs[c] : bc;
+            result[c] = vuRawMin(m_state.vf[fs][c], bc);
         applyDest(vd, result, dest);
         return;
     }
@@ -134,7 +164,7 @@ void VU1Interpreter::execUpper(uint32_t instr)
         return;
     case 0x1D: // MAXi
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] > i) ? vs[c] : i;
+            result[c] = vuRawMax(m_state.vf[fs][c], m_state.i);
         applyDest(vd, result, dest);
         return;
     case 0x1E: // MULi
@@ -144,7 +174,7 @@ void VU1Interpreter::execUpper(uint32_t instr)
         return;
     case 0x1F: // MINIi
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] < i) ? vs[c] : i;
+            result[c] = vuRawMin(m_state.vf[fs][c], m_state.i);
         applyDest(vd, result, dest);
         return;
     case 0x20: // ADDq
@@ -204,7 +234,7 @@ void VU1Interpreter::execUpper(uint32_t instr)
         return;
     case 0x2B: // MAX
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] > vt[c]) ? vs[c] : vt[c];
+            result[c] = vuRawMax(m_state.vf[fs][c], m_state.vf[ft][c]);
         applyDest(vd, result, dest);
         return;
     case 0x2C: // SUB
@@ -226,7 +256,7 @@ void VU1Interpreter::execUpper(uint32_t instr)
         return;
     case 0x2F: // MINI
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] < vt[c]) ? vs[c] : vt[c];
+            result[c] = vuRawMin(m_state.vf[fs][c], m_state.vf[ft][c]);
         applyDest(vd, result, dest);
         return;
 
