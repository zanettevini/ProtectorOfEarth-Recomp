+        tc.Run("VU0 macro memory ops address VU0 data memory with the right fields", [](TestCase &t) {
+            // VLQI/VLQD: ft = bits 20-16, is = bits 15-11. VSQI/VSQD: fs = bits 15-11, it = bits 20-16
+            // (0x4be1137d is "vsqi.xyzw vf2, (vi1++)"). All of them address VU0 data memory
+            // (EE 0x11004000, 256 quadwords), never EE RAM at vi * 16.
+            auto special2 = [](uint32_t s2, uint8_t rt, uint8_t rd, uint8_t field) {
+                Instruction inst{};
+                inst.opcode = OPCODE_COP2;
+                inst.rs = COP2_CO | 0xF;
+                inst.rt = rt;
+                inst.rd = rd;
+                inst.function = 0x3C; // force the Special2 path
+                inst.vectorInfo.vectorField = field;
+                inst.raw = (((s2 >> 2) & 0x1F) << 6) | (s2 & 0x3);
+                return inst;
+            };
+            CodeGenerator gen({}, {});
+
+            const std::string vsqi = gen.translateInstruction(special2(VU0_S2_VSQI, 1, 2, 0xF));
+            printGeneratedCode("VSQI vf2, (vi1++)", vsqi);
+            t.IsTrue(vsqi.find("0x11004000u + (((uint32_t)ctx->vi[1] & 0xFFu) << 4)") != std::string::npos,
+                     "VSQI addresses VU0 data memory through it = rt");
+            t.IsTrue(vsqi.find("ctx->vu0_vf[2]") != std::string::npos, "VSQI stores fs = rd");
+            t.IsTrue(vsqi.find("ctx->vi[1] = static_cast<uint16_t>(ctx->vi[1] + 1)") != std::string::npos,
+                     "VSQI post-increments it");
+
+            const std::string vsqd = gen.translateInstruction(special2(VU0_S2_VSQD, 3, 4, 0xF));
+            t.IsTrue(vsqd.find("ctx->vi[3] = static_cast<uint16_t>(ctx->vi[3] - 1)") != std::string::npos,
+                     "VSQD pre-decrements it = rt");
+            t.IsTrue(vsqd.find("ctx->vu0_vf[4]") != std::string::npos, "VSQD stores fs = rd");
+
+            const std::string vlqi = gen.translateInstruction(special2(VU0_S2_VLQI, 5, 6, 0xF));
+            t.IsTrue(vlqi.find("0x11004000u + (((uint32_t)ctx->vi[6] & 0xFFu) << 4)") != std::string::npos,
+                     "VLQI addresses VU0 data memory through is = rd");
+            t.IsTrue(vlqi.find("ctx->vu0_vf[5] =") != std::string::npos, "VLQI loads ft = rt");
+
+            const std::string ilwr = gen.translateInstruction(special2(VU0_S2_VILWR, 7, 8, 0x4));
+            printGeneratedCode("VILWR.y vi7, (vi8)", ilwr);
+            t.IsTrue(ilwr.find("0x11004000u + (((uint32_t)ctx->vi[8] & 0xFFu) << 4)) + 4u") != std::string::npos,
+                     "VILWR.y reads the y word of quadword is");
+            t.IsTrue(ilwr.find("ctx->vi[7] = ") != std::string::npos, "VILWR writes it = rt");
+
+            const std::string iswr = gen.translateInstruction(special2(VU0_S2_VISWR, 9, 10, 0x1));
+            t.IsTrue(iswr.find("0x11004000u + (((uint32_t)ctx->vi[10] & 0xFFu) << 4)) + 12u") != std::string::npos,
+                     "VISWR.w writes the w word of quadword is");
+
+            const std::string vlqiVi0 = gen.translateInstruction(special2(VU0_S2_VLQI, 5, 0, 0xF));
+            t.IsTrue(vlqiVi0.rfind("ctx->vi[0] = 0;") != std::string::npos,
+                     "a post-increment of VI0 must leave VI0 at 0");
+        });
