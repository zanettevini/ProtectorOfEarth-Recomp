+uint64_t VU1Interpreter::earliestPendingReadyCycle() const noexcept
+{
+    uint64_t earliest = UINT64_MAX;
+    auto consider = [&earliest](bool valid, uint64_t readyCycle)
+    {
+        if (valid && readyCycle < earliest)
+            earliest = readyCycle;
+    };
+    for (const FlagPipelineEntry &entry : m_flagPipeline)
+        consider(entry.valid, entry.readyCycle);
+    consider(m_fdiv.valid, m_fdiv.readyCycle);
+    for (const ScalarPipelineEntry &entry : m_efu)
+        consider(entry.valid, entry.readyCycle);
+    for (const PendingStore &store : m_storePipeline)
+        consider(store.valid, store.readyCycle);
+    for (const PendingVfWrite &write : m_vfWritePipeline)
+        consider(write.valid, write.readyCycle);
+    for (const PendingViWrite &write : m_viWritePipeline)
+        consider(write.valid, write.readyCycle);
+    for (const PendingAccWrite &write : m_accWritePipeline)
+        consider(write.valid, write.readyCycle);
+    return earliest;
+}
+
 void VU1Interpreter::commitReadyPipelines()
 {
+    // Nothing can be ready before the earliest queued readyCycle: skip the
+    // scan. Entries are still committed in the same order, at the same
+    // cycle, as with a scan on every cycle.
+    if (m_cycle < m_nextCommitCycle)
+        return;
+
     for (FlagPipelineEntry &entry : m_flagPipeline)
     {
         if (!entry.valid || entry.readyCycle > m_cycle)
@@ -838,6 +879,8 @@
         }
         write = {};
     }
+
+    m_nextCommitCycle = earliestPendingReadyCycle();
 }
 
