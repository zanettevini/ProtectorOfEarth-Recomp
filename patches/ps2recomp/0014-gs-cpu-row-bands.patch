+        tc.Run("GS CPU backends drawing row bands of one picture write the same bytes as one backend", [](TestCase &t)
+        {
+            // Forwards every call to two GSCpuBackends that share GS memory,
+            // band 0 and band 1 of 2. Primitives are buffered and drawn
+            // band 0 first, then band 1: the worst ordering two threads
+            // could produce.
+            class TwoBands final : public GSRasterBackend
+            {
+            public:
+                TwoBands()
+                {
+                    m_bands[0].SetRowBand(0u, 2u);
+                    m_bands[1].SetRowBand(1u, 2u);
+                }
+                void Initialize(uint8_t *vram, uint32_t size) override
+                {
+                    m_main.Initialize(vram, size);
+                    for (GSCpuBackend &band : m_bands)
+                        band.Initialize(vram, size);
+                }
+                void Reset() override { flush(); m_main.Reset(); for (GSCpuBackend &b : m_bands) b.Reset(); }
+                void Submit(const GSPrimitiveBatch &batch) override { m_pending.push_back(batch); }
+                void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &clut) override
+                {
+                    flush();
+                    for (GSCpuBackend &b : m_bands)
+                        b.LoadClut(tex0, clut);
+                }
+                void BeginTransfer(const GSTransferCommand &c) override { flush(); m_main.BeginTransfer(c); }
+                void UploadImage(const uint8_t *d, uint32_t n) override { flush(); m_main.UploadImage(d, n); }
+                void Flush() override { flush(); }
+                void TextureFlush() override { flush(); for (GSCpuBackend &b : m_bands) b.TextureFlush(); }
+                void Sync(GSSyncReason) override { flush(); }
+                PresentationFrame Present(const GSPresentationRequest &r) override { flush(); return m_main.Present(r); }
+                bool ClearFramebuffer(const GSContext &c, uint32_t rgba) override { flush(); return m_main.ClearFramebuffer(c, rgba); }
+                uint32_t ConsumeLocalToHostBytes(uint8_t *d, uint32_t n) override { flush(); return m_main.ConsumeLocalToHostBytes(d, n); }
+                uint32_t ReadVram(uint32_t psm, uint32_t b, uint32_t bw, uint32_t x, uint32_t y) const override { return m_main.ReadVram(psm, b, bw, x, y); }
+                void WriteVram(uint32_t psm, uint32_t b, uint32_t bw, uint32_t x, uint32_t y, uint32_t v) override { flush(); m_main.WriteVram(psm, b, bw, x, y, v); }
+                void SnapshotVram(std::vector<uint8_t> &out) const override { m_main.SnapshotVram(out); }
+                GSTransferSnapshot GetTransferSnapshot() const override { return m_main.GetTransferSnapshot(); }
+                void flush()
+                {
+                    for (GSCpuBackend &band : m_bands)
+                        for (const GSPrimitiveBatch &batch : m_pending)
+                            band.Submit(batch);
+                    m_pending.clear();
+                }
+
+            private:
+                GSCpuBackend m_main;
+                GSCpuBackend m_bands[2];
+                std::vector<GSPrimitiveBatch> m_pending;
+            };
+
+            const auto drawScene = [](GS &gs)
+            {
+                constexpr uint64_t kFrame = (0ull << 0) | (2ull << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24);
+                constexpr uint64_t kZbuf = (40ull << 0) | (static_cast<uint64_t>(GS_PSM_Z32) << 24);
+                constexpr uint64_t kScissor = (127ull << 16) | (127ull << 48);
+                // Texture: 16x16 CT32 at block 1600 (page 50), written below.
+                constexpr uint64_t kTex0 = (1600ull << 0) | (1ull << 14) | (static_cast<uint64_t>(GS_PSM_CT32) << 20) |
+                                           (4ull << 26) | (4ull << 30) | (1ull << 34);
+                for (uint32_t y = 0; y < 16u; ++y)
+                    for (uint32_t x = 0; x < 16u; ++x)
+                        gs.WriteVram(GS_PSM_CT32, 1600u, 1u, x, y, 0x80000000u | (x * 16u) | ((y * 16u) << 8) | 0x400000u);
+                gs.writeRegister(GS_REG_FRAME_1, kFrame);
+                gs.writeRegister(GS_REG_ZBUF_1, kZbuf);
+                gs.writeRegister(GS_REG_SCISSOR_1, kScissor);
+                gs.writeRegister(GS_REG_XYOFFSET_1, 0ull);
+                // Z test GEQUAL, alpha test off; alpha blend (Cs - Cd) * As + Cd.
+                gs.writeRegister(GS_REG_TEST_1, (1ull << 16) | (2ull << 17));
+                gs.writeRegister(GS_REG_ALPHA_1, (0ull << 0) | (1ull << 2) | (0ull << 4) | (1ull << 6));
+                gs.writeRegister(GS_REG_TEX0_1, kTex0);
+
+                const auto xy = [](uint32_t x, uint32_t y, uint32_t z)
+                { return static_cast<uint64_t>(x * 16u) | (static_cast<uint64_t>(y * 16u) << 16) | (static_cast<uint64_t>(z) << 32); };
+
+                // Gouraud, blended triangles that overlap and cross many rows.
+                gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(GS_PRIM_TRIANGLE) | (1ull << 3) | (1ull << 6));
+                for (uint32_t i = 0; i < 6u; ++i)
+                {
+                    gs.writeRegister(GS_REG_RGBAQ, 0x40000000ull | (i * 40u));
+                    gs.writeRegister(GS_REG_XYZ2, xy(5u + i * 7u, 3u + i * 5u, 100u + i));
+                    gs.writeRegister(GS_REG_RGBAQ, 0x80008000ull | (i * 20u));
+                    gs.writeRegister(GS_REG_XYZ2, xy(120u - i * 9u, 10u + i * 3u, 200u - i));
+                    gs.writeRegister(GS_REG_RGBAQ, 0x7000F000ull);
+                    gs.writeRegister(GS_REG_XYZ2, xy(30u + i * 11u, 125u - i * 13u, 150u));
+                }
+                // Textured (FST) sprite over all of them, blended.
+                gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(GS_PRIM_SPRITE) | (1ull << 4) | (1ull << 6) | (1ull << 8));
+                gs.writeRegister(GS_REG_RGBAQ, 0x80808080ull);
+                gs.writeRegister(GS_REG_UV, 0ull);
+                gs.writeRegister(GS_REG_XYZ2, xy(20u, 17u, 300u));
+                gs.writeRegister(GS_REG_UV, static_cast<uint64_t>(16u * 16u) | (static_cast<uint64_t>(16u * 16u) << 16));
+                gs.writeRegister(GS_REG_XYZ2, xy(100u, 90u, 300u));
+                gs.writeRegister(GS_REG_FINISH, 0ull);
+            };
+
+            std::vector<uint8_t> vramOne(PS2_GS_VRAM_SIZE, 0u);
+            GS one;
+            one.init(vramOne.data(), static_cast<uint32_t>(vramOne.size()), nullptr);
+            drawScene(one);
+
+            std::vector<uint8_t> vramTwo(PS2_GS_VRAM_SIZE, 0u);
+            GS two;
+            two.init(vramTwo.data(), static_cast<uint32_t>(vramTwo.size()), nullptr);
