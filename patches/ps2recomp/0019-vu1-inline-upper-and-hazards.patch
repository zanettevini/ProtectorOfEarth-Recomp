+// The VU upper (FMAC) executor, inline: included by runtime/ps2_vu1.h so
+// that execPair called with a constant decoded pair (translated VU1 code)
+// can fold the opcode switch and the dest mask. Moved unchanged from
+// src/lib/vu/ps2_vu1_upper.cpp.
