+            applyFmacDestAcc(result, dest);
+            return;
+        case 0x28: // ADDA
+            for (int c = 0; c < 4; c++)
+                result[c] = vs[c] + vt[c];
+            applyFmacDestAcc(result, dest);
+            return;
+        case 0x29: // MADDA
+            for (int c = 0; c < 4; c++)
