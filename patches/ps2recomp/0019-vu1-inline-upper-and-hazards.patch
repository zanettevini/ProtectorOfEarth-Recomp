+        case 0x2F:
+        case 0x30: // NOP
+            return;
+        default:
+            reportReservedInstruction(true, instr);
+            return;
+        }
+    }
+
+    case 0x30:
+    case 0x31:
+    case 0x32:
+    case 0x33:
+    default:
+        reportReservedInstruction(true, instr);
+        return;
+    }
+}
