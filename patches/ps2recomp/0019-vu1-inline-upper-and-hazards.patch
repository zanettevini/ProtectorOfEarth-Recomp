-    // MAX/MINI compare the raw 32-bit patterns, as sign-magnitude numbers
-    // (the order of IEEE floats), and return one operand unchanged. They do
-    // not flush denormals to zero like the arithmetic ops: games use
-    // "MAX.xyzw vfA, vfB, vfB" as a plain move of integer data (Ben 10 copies
-    // its VIF-unpacked vertex colours, small integers whose bit patterns are
-    // denormal floats, into the GIF packet that way; flushing them made every
-    // textured model black).
-    float vuRawMax(float a, float b)
-    {
-        int32_t ia, ib;
-        std::memcpy(&ia, &a, 4);
-        std::memcpy(&ib, &b, 4);
-        const int32_t r = (ia < 0 && ib < 0) ? (ia < ib ? ia : ib) : (ia > ib ? ia : ib);
-        float out;
-        std::memcpy(&out, &r, 4);
-        return out;
-    }
-
-    float vuRawMin(float a, float b)
-    {
-        int32_t ia, ib;
-        std::memcpy(&ia, &a, 4);
-        std::memcpy(&ib, &b, 4);
-        const int32_t r = (ia < 0 && ib < 0) ? (ia > ib ? ia : ib) : (ia < ib ? ia : ib);
-        float out;
-        std::memcpy(&out, &r, 4);
-        return out;
-    }
