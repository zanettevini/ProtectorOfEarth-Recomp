+#include <cmath>
+#include <cstring>
+#include <limits>
+
+namespace ps2_vu1_upper_detail
+{
+    inline int32_t vuFloatToInt(float value, float scale)
+    {
+        const double scaled = static_cast<double>(value) * static_cast<double>(scale);
+        if (scaled >= static_cast<double>(std::numeric_limits<int32_t>::max()))
+            return std::numeric_limits<int32_t>::max();
+        if (scaled <= static_cast<double>(std::numeric_limits<int32_t>::min()))
+            return std::numeric_limits<int32_t>::min();
+        return static_cast<int32_t>(scaled);
+    }
+
+    // MAX/MINI compare the raw 32-bit patterns, as sign-magnitude numbers
+    // (the order of IEEE floats), and return one operand unchanged. They do
+    // not flush denormals to zero like the arithmetic ops: games use
+    // "MAX.xyzw vfA, vfB, vfB" as a plain move of integer data (Ben 10 copies
+    // its VIF-unpacked vertex colours, small integers whose bit patterns are
+    // denormal floats, into the GIF packet that way; flushing them made every
+    // textured model black).
+    inline float vuRawMax(float a, float b)
+    {
+        int32_t ia, ib;
+        std::memcpy(&ia, &a, 4);
+        std::memcpy(&ib, &b, 4);
+        const int32_t r = (ia < 0 && ib < 0) ? (ia < ib ? ia : ib) : (ia > ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, 4);
+        return out;
+    }
+
+    inline float vuRawMin(float a, float b)
+    {
+        int32_t ia, ib;
+        std::memcpy(&ia, &a, 4);
+        std::memcpy(&ib, &b, 4);
+        const int32_t r = (ia < 0 && ib < 0) ? (ia > ib ? ia : ib) : (ia < ib ? ia : ib);
+        float out;
+        std::memcpy(&out, &r, 4);
+        return out;
+    }
