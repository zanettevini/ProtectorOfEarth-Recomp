From: Protector of Earth Recomp
Subject: [PATCH] VU1 interpreter: lower executor inline header, pluggable lower executor

What it is for:
  Translated VU1 code (patches 0018-0020) still called the lower executor
  (loads, stores, integer ops, branches, XGKICK...) out of line with the
  instruction as an argument, so its switch was never folded.

The change:
  - The lower executor moves unchanged to
    include/runtime/ps2_vu1_lower_inl.h as VU1Interpreter::execLowerInline
    (forced inline; its field helpers renamed, as FT/FS clash with
    ps2xRecomp's macros). That header is not included by runtime/ps2_vu1.h
    (it needs the memory and GIF headers): src/lib/vu/ps2_vu1_lower.cpp
    builds the interpreter's out-of-line execLower from it, and
    VU1NativeLowerAccess lets translated code build one function per
    distinct lower word.
  - execPairWith takes a lower executor as well; execPair passes the
    interpreter's execLower. VU1NativeAccess::execPairUpperLower<U, L>
    runs a pair with a given upper and lower function.
  Same results. Tested: ps2xTest 454/454; the Ben 10 port's 40 captured
  VU1 workloads give the same checksums with and without its translated
  code; callgrind: translated code 446 M -> 418 M instructions.

--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -162,6 +162,7 @@
 
 private:
     friend struct VU1NativeAccess;
+    friend struct VU1NativeLowerAccess;
 
     struct FlagPipelineEntry
     {
@@ -315,8 +316,8 @@
     // execPair with the upper instruction run by `upper(*this)`: translated
     // code passes a function specialised for the pair's upper word, shared by
     // every pair with that word (fewer copies of the upper executor to build).
-    template <class UpperExec>
-    StepResult execPairWith(const DecodedInstructionPair &decoded, RunFrame &frame, UpperExec upper);
+    template <class UpperExec, class LowerExec>
+    StepResult execPairWith(const DecodedInstructionPair &decoded, RunFrame &frame, UpperExec upper, LowerExec lower);
     void resolveNativeCode(uint8_t *vuCode, uint32_t codeSize, PS2Memory *memory);
     std::array<NativePairFn, 0x4000u / 8u> m_nativeTable{};
     const uint8_t *m_nativeCode = nullptr;
@@ -338,6 +339,8 @@
 
     void execUpper(uint32_t instr); // inline, runtime/ps2_vu1_upper_inl.h
     void execLower(uint32_t instr, uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory, uint32_t upperInstr);
+    // The same, inline (runtime/ps2_vu1_lower_inl.h, not included here).
+    void execLowerInline(uint32_t instr, uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory, uint32_t upperInstr);
 
     void applyDest(float *dst, const float *result, uint8_t dest);
     void applyDestAcc(const float *result, uint8_t dest);
@@ -503,12 +506,16 @@
 PS2_VU_FORCEINLINE VU1Interpreter::StepResult VU1Interpreter::execPair(const DecodedInstructionPair &decoded, RunFrame &f)
 {
     const uint32_t upperWord = decoded.upper;
-    return execPairWith(decoded, f, [upperWord](VU1Interpreter &vu)
-                        { vu.execUpper(upperWord); });
+    const uint32_t lowerWord = decoded.lower;
+    return execPairWith(
+        decoded, f, [upperWord](VU1Interpreter &vu)
+        { vu.execUpper(upperWord); },
+        [lowerWord, upperWord](VU1Interpreter &vu, RunFrame &frame)
+        { vu.execLower(lowerWord, frame.vuData, frame.dataSize, *frame.gs, frame.memory, upperWord); });
 }
 
-template <class UpperExec>
-PS2_VU_FORCEINLINE VU1Interpreter::StepResult VU1Interpreter::execPairWith(const DecodedInstructionPair &decoded, RunFrame &f, UpperExec upper)
+template <class UpperExec, class LowerExec>
+PS2_VU_FORCEINLINE VU1Interpreter::StepResult VU1Interpreter::execPairWith(const DecodedInstructionPair &decoded, RunFrame &f, UpperExec upper, LowerExec lower)
 {
     if (decoded.upperUsage.reserved || decoded.lowerUsage.reserved)
     {
@@ -578,7 +585,7 @@
         std::memcpy(m_state.vf[decoded.upperVfShadowReg],
                     oldVf,
                     sizeof(oldVf));
-        execLower(decoded.lower, f.vuData, f.dataSize, *f.gs, f.memory, decoded.upper);
+        lower(*this, f);
         std::memcpy(m_state.vf[decoded.upperVfShadowReg],
                     upperVf,
                     sizeof(upperVf));
@@ -586,7 +593,7 @@
     else
     {
         upper(*this);
-        execLower(decoded.lower, f.vuData, f.dataSize, *f.gs, f.memory, decoded.upper);
+        lower(*this, f);
     }
 
     m_viBranchBackupValid = false;
@@ -710,8 +717,26 @@
     template <void (*Upper)(VU1Interpreter &)>
     static PS2_VU_FORCEINLINE Result execPairUpper(VU1Interpreter &vu, const Pair &pair, Frame &frame)
     {
-        return vu.execPairWith(pair, frame, [](VU1Interpreter &v)
-                               { Upper(v); });
+        const uint32_t lowerWord = pair.lower;
+        const uint32_t upperWord = pair.upper;
+        return vu.execPairWith(
+            pair, frame, [](VU1Interpreter &v)
+            { Upper(v); },
+            [lowerWord, upperWord](VU1Interpreter &v, Frame &fr)
+            { v.execLower(lowerWord, fr.vuData, fr.dataSize, *fr.gs, fr.memory, upperWord); });
+    }
+    // The same with the lower instruction run by Lower (a function that runs
+    // one lower word, built once per distinct word).
+    using LowerFn = void (*)(VU1Interpreter &, uint8_t *, uint32_t, GS &, PS2Memory *, uint32_t);
+    template <void (*Upper)(VU1Interpreter &), LowerFn Lower>
+    static PS2_VU_FORCEINLINE Result execPairUpperLower(VU1Interpreter &vu, const Pair &pair, Frame &frame)
+    {
+        const uint32_t upperWord = pair.upper;
+        return vu.execPairWith(
+            pair, frame, [](VU1Interpreter &v)
+            { Upper(v); },
+            [upperWord](VU1Interpreter &v, Frame &fr)
+            { Lower(v, fr.vuData, fr.dataSize, *fr.gs, fr.memory, upperWord); });
     }
     // One upper instruction, inline: called with a constant word, the
     // compiler keeps only that instruction's code.
