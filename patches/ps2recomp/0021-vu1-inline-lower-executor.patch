+    // The field helpers of src/lib/vu/ps2_vu1_detail.h under other names
+    // (FT, FS... clash with macros of ps2xRecomp's instructions.h).
+    inline uint8_t fieldFt(uint32_t i) { return (uint8_t)((i >> 16) & 0x1F); }
+    inline uint8_t fieldFs(uint32_t i) { return (uint8_t)((i >> 11) & 0x1F); }
+    inline uint8_t fieldVit(uint32_t i) { return (uint8_t)((i >> 16) & 0xF); }
+    inline uint8_t fieldVis(uint32_t i) { return (uint8_t)((i >> 11) & 0xF); }
+    inline uint8_t fieldVid(uint32_t i) { return (uint8_t)((i >> 6) & 0xF); }
+    inline int16_t fieldImm11(uint32_t i) { return (int16_t)(int32_t)((int32_t)(i << 21) >> 21); }
+}
