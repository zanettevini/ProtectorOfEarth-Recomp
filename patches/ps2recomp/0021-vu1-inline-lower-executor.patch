+namespace ps2_vu1_lower_detail
+{
+    inline float vuEatan(float value)
+    {
+        constexpr float coefficients[] = {
+            0.999999344348907f,
+            -0.333298563957214f,
+            0.199465364217758f,
+            -0.13085337519646f,
+            0.096420042216778f,
+            -0.055909886956215f,
+            0.021861229091883f,
+            -0.004054057877511f};
+        constexpr float quarterPi = 0.785398185253143f;
+
+        const float squared = value * value;
+        float polynomial = coefficients[7];
+        for (int index = 6; index >= 0; --index)
+            polynomial = coefficients[index] + squared * polynomial;
+        return quarterPi + value * polynomial;
+    }
+
+    inline float vuEsin(float value)
+    {
+        constexpr float coefficients[] = {
+            1.0f,
+            -0.166666567325592f,
+            0.008333025500178f,
+            -0.000198074136279f,
+            0.000002601886990f};
