From: Protector of Earth Recomp
Subject: [PATCH] VU1 interpreter: exact fast path for the FMAC flag model

What it is for:
  For every lane of every FMAC instruction the model recomputes the result
  in long double (80-bit x87 with GCC/Clang on x86-64) to classify it
  (zero, sign, underflow, overflow), and does the same for the product of
  product-sum instructions (sticky flags). The float result is only
  replaced when the exact value is zero, above FLT_MAX or below FLT_MIN.

The change:
  - normalizeFmacResult: when the float result's exponent is 3..252 the
    lane's flags are its sign and the value is kept, without the exact
    computation. For one operation (ADD, SUB, MUL and their forms) the
    exact value is within one ulp of the result; for ACC +/- product the
    rounded product must also not have overflowed (exponent <= 253) and be
    at most 2^20 times the result, which keeps the exact value within a
    quarter of the result. Both hold for any rounding mode and with a fused
    multiply-add. Otherwise the exact model runs as before.
  - calculateFmacProductSticky: a zero operand gives an exact signed zero
    (flags Z and the product's sign); a float product with exponent
    2..253 gives the sign only; otherwise the exact model.
  - fmacProductOperands(): the product operands of a lane, shared by both.
  Same results. Tested: ps2xTest 454/454; the Ben 10 port's 40 captured
  VU1 workloads give the same checksums and cycle count with and without
  its translated code; a randomised comparison (millions of lanes, many
  near zero, the range limits and in cancellation) against the exact model
  found no difference.

--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -397,6 +397,7 @@
     bool calculateFmacExactResult(uint32_t component, long double &result) const;
     uint8_t normalizeFmacExactResult(float &value, long double exactResult) const;
     uint32_t calculateFmacProductSticky(uint8_t dest) const;
+    void fmacProductOperands(uint32_t component, float &left, float &right) const;
     void updateFmacFlags(const uint8_t laneFlags[4], uint8_t dest, uint32_t extraSticky);
     void queueFsset(uint16_t immediate);
     void queueClip(uint32_t clip);
--- a/ps2xRuntime/include/runtime/ps2_vu1_fmac_inl.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1_fmac_inl.h
@@ -11,6 +11,31 @@
 #include <cstring>
 #include <limits>
 
+namespace ps2_vu1_fmac_detail
+{
+    inline uint32_t exponentOf(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return (bits >> 23) & 0xFFu;
+    }
+
+    // Whether the upper word computes ACC +/- a product (MADD, MSUB,
+    // OPMSUB and their ACC/bc/q/i forms): their result is rounded twice in
+    // float (product, then sum), once in the exact model.
+    inline bool isProductSum(uint32_t upper)
+    {
+        const uint32_t op = upper & 0x3Fu;
+        const uint32_t special = op >= 0x3Cu ? ((upper & 3u) | ((upper >> 4) & 0x7Cu)) : 0xFFu;
+        return (op >= 0x08u && op <= 0x0Fu) ||
+               op == 0x21u || op == 0x23u || op == 0x25u || op == 0x27u ||
+               op == 0x29u || op == 0x2Du || op == 0x2Eu ||
+               (special >= 0x08u && special <= 0x0Fu) ||
+               special == 0x21u || special == 0x23u || special == 0x25u ||
+               special == 0x27u || special == 0x29u || special == 0x2Du;
+    }
+}
+
 PS2_VU_FORCEINLINE float VU1Interpreter::broadcast(const float *vf, uint8_t bc)
 {
     return normalizeOperand(vf[bc & 3u]);
@@ -70,6 +95,35 @@
         if ((dest & static_cast<uint8_t>(1u << (3u - component))) == 0u)
             continue;
 
+        // Fast path, exact (findings/21 s.10). The exact model only changes
+        // the float result when the exact value is zero, above FLT_MAX or
+        // below FLT_MIN; otherwise the flags are just its sign. With the
+        // float result's exponent in 3..252 (|r| in [2^-124, 2^126)):
+        // - one operation (ADD, SUB, MUL...): the exact value is within one
+        //   ulp of r, so it is nonzero, has r's sign and is in range;
+        // - ACC +/- product: also the rounded product p is off by at most
+        //   one ulp(p); with p not overflowed (exponent <= 253) and at most
+        //   2^20 times |r|, the exact value is within |r|/4 of r.
+        // This holds for any rounding mode and with a fused multiply-add.
+        if (const uint32_t exponent = ps2_vu1_fmac_detail::exponentOf(result[component]);
+            exponent >= 3u && exponent <= 252u)
+        {
+            bool safe = true;
+            if (ps2_vu1_fmac_detail::isProductSum(m_currentUpperInstruction))
+            {
+                float left = 0.0f;
+                float right = 0.0f;
+                fmacProductOperands(component, left, right);
+                const uint32_t productExponent = ps2_vu1_fmac_detail::exponentOf(left * right);
+                safe = productExponent <= 253u && productExponent <= exponent + 20u;
+            }
+            if (safe)
+            {
+                laneFlags[component] = std::signbit(result[component]) ? 0x2u : 0u;
+                continue;
+            }
+        }
+
         long double exactResult = 0.0L;
         if (calculateFmacExactResult(component, exactResult))
         {
