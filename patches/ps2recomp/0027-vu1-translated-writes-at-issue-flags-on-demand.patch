+PS2_VU_FORCEINLINE VU1Interpreter::FlagPipelineEntry *VU1Interpreter::appendFlagEntry(uint32_t errorCode, bool upper)
+{
+    if (m_flagCount == kMaxFlagEntries) [[unlikely]]
+        materializeFlags();
+    if (m_flagCount == kMaxFlagEntries)
+    {
+        reportReservedInstruction(upper, errorCode);
+        return nullptr;
+    }
+    FlagPipelineEntry &entry = m_flagPipeline[(m_flagHead + m_flagCount) % kMaxFlagEntries];
+    ++m_flagCount;
+    entry = {};
+    entry.valid = true;
+    entry.issueCycle = m_cycle;
+    entry.readyCycle = m_cycle + kFmacLatency;
+    return &entry;
+}
+
+template <bool kConst>
+PS2_VU_FORCEINLINE void VU1Interpreter::storeOrQueue(uint32_t address, const uint32_t words[4], uint8_t laneMask)
+{
+    if constexpr (!kConst)
+    {
+        queueStore(address, words, laneMask);
+    }
+    else if (m_activeVuData && address + 16u <= m_activeVuDataSize)
+    {
+        // As commitReadyPipelines writes a store.
+        uint32_t current[4]{};
+        std::memcpy(current, m_activeVuData + address, sizeof(current));
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((laneMask & static_cast<uint8_t>(1u << (3u - component))) != 0u)
+                current[component] = words[component];
+        }
+        std::memcpy(m_activeVuData + address, current, sizeof(current));
+    }
+}
+
+inline void VU1Interpreter::materializeFlags()
+{
+    while (m_flagCount != 0u)
+    {
+        FlagPipelineEntry &entry = m_flagPipeline[m_flagHead];
+        if (entry.readyCycle > m_cycle)
+            return;
+        if (entry.writesMac)
+            m_state.mac = entry.mac;
+        if (entry.writesStatus)
+        {
+            const uint32_t current = entry.status & 0xFu;
+            m_state.status = (m_state.status & 0xFF0u) | current | ((current | entry.extraSticky) << 6);
+        }
+        if (entry.writesSticky)
+        {
+            m_state.status = (m_state.status & 0x03Fu) | (entry.status & 0xFC0u);
+        }
+        if (entry.writesClip)
+            m_state.clip = entry.clip;
+        entry.valid = false;
+        m_flagHead = (m_flagHead + 1u) % kMaxFlagEntries;
+        --m_flagCount;
+    }
+}
+
+inline bool VU1Interpreter::flagEntryPending() const noexcept
+{
+    return m_flagCount != 0u &&
+           m_flagPipeline[(m_flagHead + m_flagCount - 1u) % kMaxFlagEntries].readyCycle > m_cycle;
+}
+
+inline uint64_t VU1Interpreter::firstPendingFlagCycle() const noexcept
+{
+    for (uint32_t i = 0; i < m_flagCount; ++i)
+    {
+        const FlagPipelineEntry &entry = m_flagPipeline[(m_flagHead + i) % kMaxFlagEntries];
+        if (entry.readyCycle > m_cycle)
+            return entry.readyCycle;
+    }
+    return UINT64_MAX;
+}
+
