+// calculatePairReadyCycle and markPairWrites for a pair known at compile
+// time: the same checks and stores, unrolled (no walk over the usage).
+template <const VU1Interpreter::DecodedInstructionPair &D>
+PS2_VU_FORCEINLINE uint64_t VU1Interpreter::calculatePairReadyCycleConst() const
+{
+    uint64_t ready = m_cycle;
+    if constexpr (D.upperUsage.vfReadCount > 0u)
+        maxVfReady<D.upperUsage.vfRead[0].reg, static_cast<uint8_t>(D.upperUsage.vfRead[0].lanes & 0xFu)>(ready);
+    if constexpr (D.upperUsage.vfReadCount > 1u)
+        maxVfReady<D.upperUsage.vfRead[1].reg, static_cast<uint8_t>(D.upperUsage.vfRead[1].lanes & 0xFu)>(ready);
+    maxViReady<static_cast<uint16_t>(D.upperUsage.viRead & 0xFFFEu)>(ready);
+    maxAccReady<static_cast<uint8_t>(D.upperUsage.accRead & 0xFu)>(ready);
+    if constexpr (D.lowerUsage.vfReadCount > 0u)
+        maxVfReady<D.lowerUsage.vfRead[0].reg, static_cast<uint8_t>(D.lowerUsage.vfRead[0].lanes & 0xFu)>(ready);
+    if constexpr (D.lowerUsage.vfReadCount > 1u)
+        maxVfReady<D.lowerUsage.vfRead[1].reg, static_cast<uint8_t>(D.lowerUsage.vfRead[1].lanes & 0xFu)>(ready);
+    maxViReady<static_cast<uint16_t>(D.lowerUsage.viRead & 0xFFFEu)>(ready);
+    maxAccReady<static_cast<uint8_t>(D.lowerUsage.accRead & 0xFu)>(ready);
+
+    if constexpr (D.lowerUsage.pipeline == PipelineFdiv)
+        if (m_fdiv.valid)
+            ready = std::max(ready, m_fdiv.readyCycle);
+    if constexpr (D.lowerUsage.pipeline == PipelineEfu)
+        ready = std::max(ready, m_efuResourceReady);
+    if constexpr (D.lowerUsage.waitQ)
+        if (m_fdiv.valid)
+            ready = std::max(ready, m_fdiv.readyCycle);
+    if constexpr (D.lowerUsage.waitP)
+    {
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid)
+                ready = std::max(ready, entry.readyCycle);
+    }
+    if constexpr (D.lowerUsage.pipeline == PipelineXgkick)
+        if (m_xgkick.active)
+            ready = std::max(ready, m_cycle + 1u);
+    return ready;
+}
+
+template <const VU1Interpreter::DecodedInstructionPair &D>
+PS2_VU_FORCEINLINE void VU1Interpreter::markPairWritesConst()
+{
+    constexpr VfAccess lowerWrite = D.lowerUsage.vfWrite;
+    if constexpr (lowerWrite.reg != 0u && D.suppressedLowerVf != lowerWrite.reg)
+        markVfReady<lowerWrite.reg, static_cast<uint8_t>(lowerWrite.lanes & 0xFu),
+                    D.lowerUsage.vfLatency != 0u ? D.lowerUsage.vfLatency : D.lowerUsage.latency>();
+    constexpr VfAccess upperWrite = D.upperUsage.vfWrite;
+    if constexpr (upperWrite.reg != 0u)
+        markVfReady<upperWrite.reg, static_cast<uint8_t>(upperWrite.lanes & 0xFu),
+                    D.upperUsage.vfLatency != 0u ? D.upperUsage.vfLatency : D.upperUsage.latency>();
+    markViReady<static_cast<uint16_t>(D.lowerUsage.viWrite & 0xFFFEu),
+                D.lowerUsage.viLatency != 0u ? D.lowerUsage.viLatency : D.lowerUsage.latency>();
+    constexpr uint8_t accWrite = D.upperUsage.accWrite;
+    if constexpr ((accWrite & 0x8u) != 0u) m_accReady[0] = m_cycle + kAccForwardLatency;
+    if constexpr ((accWrite & 0x4u) != 0u) m_accReady[1] = m_cycle + kAccForwardLatency;
+    if constexpr ((accWrite & 0x2u) != 0u) m_accReady[2] = m_cycle + kAccForwardLatency;
+    if constexpr ((accWrite & 0x1u) != 0u) m_accReady[3] = m_cycle + kAccForwardLatency;
+}
