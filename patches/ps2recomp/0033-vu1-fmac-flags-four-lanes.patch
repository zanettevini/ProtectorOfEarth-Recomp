+// The common case of normalizeFmacResult + calculateFmacProductSticky +
+// updateFmacFlags for all four lanes at once (findings/21 s.20): when every
+// written lane takes the per-lane fast paths there (result exponent 3..252;
+// for a product-sum also a product exponent of at most 253, at most
+// exponent + 20, and either 2 or more or a zero operand), the result is left
+// as it is, each lane's flags are just its sign, and the sticky flags of the
+// products are their zero-operand and sign bits. Then this appends the same
+// flag entry those three would and returns true; otherwise it changes
+// nothing and returns false, and the per-lane code runs as before.
+PS2_VU_FMAC_INLINE bool VU1Interpreter::fmacFlagsFast(const float *result, uint8_t dest, bool productSum,
+                                                      const float *productLeft, const float *productRight)
+{
+#if PS2_VU_FMAC_SIMD
+    if (dest == 0u)
+        return false; // no flag entry at all: left to the general code
+    const uint32_t destLanes = ps2_vu1_fmac_detail::kReverse4[dest & 0xFu];
+    const __m128i exponentLow = _mm_set1_epi32(0xFF);
+    const __m128 r = _mm_loadu_ps(result);
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(_mm_castps_si128(r), 23), exponentLow);
+    // 3 <= e <= 252
+    __m128i fast = _mm_and_si128(_mm_cmpgt_epi32(e, _mm_set1_epi32(2)), _mm_cmplt_epi32(e, _mm_set1_epi32(253)));
+    uint32_t extraSticky = 0u;
+    if (productSum)
+    {
+        const __m128 left = _mm_loadu_ps(productLeft);
+        const __m128 right = _mm_loadu_ps(productRight);
+        const __m128 product = _mm_mul_ps(left, right);
+        const __m128i pe = _mm_and_si128(_mm_srli_epi32(_mm_castps_si128(product), 23), exponentLow);
+        // pe <= 253 and pe <= e + 20
+        const __m128i safe = _mm_and_si128(_mm_cmplt_epi32(pe, _mm_set1_epi32(254)),
+                                           _mm_cmplt_epi32(pe, _mm_add_epi32(e, _mm_set1_epi32(21))));
+        const __m128 zero = _mm_setzero_ps();
+        const __m128 zeroOperand = _mm_or_ps(_mm_cmpeq_ps(left, zero), _mm_cmpeq_ps(right, zero));
+        // the product's own flags without the exact model: a zero operand,
+        // or an exponent of 2 or more (253 at most is checked above)
+        const __m128i productFast = _mm_or_si128(_mm_castps_si128(zeroOperand), _mm_cmpgt_epi32(pe, _mm_set1_epi32(1)));
+        fast = _mm_and_si128(fast, _mm_and_si128(safe, productFast));
+        if ((static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(fast))) & destLanes) != destLanes)
+            return false;
+        if ((static_cast<uint32_t>(_mm_movemask_ps(zeroOperand)) & destLanes) != 0u)
+            extraSticky |= 0x1u;
+        if ((static_cast<uint32_t>(_mm_movemask_ps(product)) & destLanes) != 0u)
+            extraSticky |= 0x2u;
+    }
+    else if ((static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(fast))) & destLanes) != destLanes)
+        return false;
+
+    // Each lane's flags are its sign (S); MAC holds S in bits 7:4, x = bit 7.
+    const uint32_t signLanes = static_cast<uint32_t>(_mm_movemask_ps(r)) & destLanes;
+    FlagPipelineEntry *entry = appendFlagEntry(0xFFFFFFFFu, true);
+    if (entry)
+    {
+        entry->mac = static_cast<uint32_t>(ps2_vu1_fmac_detail::kReverse4[signLanes]) << 4;
+        entry->status = signLanes != 0u ? 0x2u : 0u;
+        entry->extraSticky = extraSticky;
+        entry->writesMac = true;
+        entry->writesStatus = true;
+    }
+    return true;
+#else
+    (void)result;
+    (void)dest;
+    (void)productSum;
+    (void)productLeft;
+    (void)productRight;
+    return false;
+#endif
+}
