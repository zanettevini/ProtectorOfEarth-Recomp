     }
+
+    // A dest mask (x = bit 3 ... w = bit 0) with its bits reversed: lane
+    // order (x = bit 0), as _mm_movemask_ps returns it, and back.
+    // VU1Interpreter::normalizeOperand on four lanes: exponent 0 becomes a
+    // signed zero, exponent 255 the largest finite value with its sign.
+    inline void normalizeOperands4(const float *in, float *out)
+    {
+#if PS2_VU_FMAC_SIMD
+        const __m128i bits = _mm_castps_si128(_mm_loadu_ps(in));
+        const __m128i exponentMask = _mm_set1_epi32(0x7F800000);
+        const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i exponent = _mm_and_si128(bits, exponentMask);
+        const __m128i isZero = _mm_cmpeq_epi32(exponent, _mm_setzero_si128());
+        const __m128i isMax = _mm_cmpeq_epi32(exponent, exponentMask);
+        __m128i r = _mm_or_si128(_mm_and_si128(isZero, sign), _mm_andnot_si128(isZero, bits));
+        r = _mm_or_si128(_mm_and_si128(isMax, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF))), _mm_andnot_si128(isMax, r));
+        _mm_storeu_ps(out, _mm_castsi128_ps(r));
+#else
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            uint32_t b = 0;
+            std::memcpy(&b, &in[component], 4);
+            const uint32_t exponent = (b >> 23) & 0xFFu;
+            if (exponent == 0u)
+                b &= 0x80000000u;
+            else if (exponent == 0xFFu)
+                b = (b & 0x80000000u) | 0x7F7FFFFFu;
+            std::memcpy(&out[component], &b, 4);
+        }
+#endif
+    }
+
+    constexpr uint8_t kReverse4[16] = {0x0u, 0x8u, 0x4u, 0xCu, 0x2u, 0xAu, 0x6u, 0xEu,
+                                       0x1u, 0x9u, 0x5u, 0xDu, 0x3u, 0xBu, 0x7u, 0xFu};
 }
 
