+bool EeScheduler::pollAsyncVif1(bool idle)
+{
+    PS2Memory &memory = m_runtime.memory();
+    bool completed = false;
+    if (memory.vif1InFlight())
+    {
+        if (memory.vif1KickSerial() != m_vif1SeenKickSerial)
+        {
+            m_vif1SeenKickSerial = memory.vif1KickSerial();
+            m_vif1KickCycle = m_eeCycle;
+        }
+        const uint64_t limit = memory.asyncVif1DeliveryCycles();
+        if (idle)
+        {
+            memory.syncVif1(PS2Memory::Vif1SyncReason::Idle);
+            completed = true;
+        }
+        else if (limit != 0u && m_eeCycle - m_vif1KickCycle >= limit)
+        {
+            memory.syncVif1(PS2Memory::Vif1SyncReason::Cycles);
+            completed = true;
+        }
+    }
+    if (memory.takeVif1Delivered())
+    {
+        m_runtime.drainCompletedDmacHandlers(memory.getRDRAM());
+        completed = true;
+    }
+    return completed;
+}
