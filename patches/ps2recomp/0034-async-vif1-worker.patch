+// ---------------------------------------------------------------------------
+// VIF1 on a worker thread (opt-in; see ps2_memory.h, and the port's
+// docs/findings/21 s.22).
+// ---------------------------------------------------------------------------
+namespace
+{
+    // True on the VIF1 worker thread.
+    thread_local bool tl_onVif1Worker = false;
+}
+
+void PS2Memory::setAsyncVif1(bool enabled, uint64_t deliveryCycles)
+{
+    if (!enabled)
+        syncVif1(Vif1SyncReason::Other);
+    m_asyncVif1 = enabled;
+    m_vif1DeliveryCycles = deliveryCycles;
+}
+
+// What processPendingTransfers does at the end for a VIF1 transfer, as a
+// member: D_STAT CIS (and the summary bit), the DMAC cause, CHCR STR and
+// QWC cleared.
+void PS2Memory::completeDmaChannel(uint32_t channelBit, uint32_t channelBase)
+{
+    constexpr uint32_t D_STAT = 0x1000E010u;
+    uint32_t dstat = m_ioRegisters.count(D_STAT) ? m_ioRegisters[D_STAT] : 0u;
+    dstat |= (1u << channelBit);
+    const uint32_t status = dstat & 0x3FFu;
+    const uint32_t mask = (dstat >> 16) & 0x3FFu;
+    if ((status & mask) != 0u)
+        dstat |= (1u << 31);
+    else
+        dstat &= ~(1u << 31);
+    m_ioRegisters[D_STAT] = dstat;
+    queueCompletedDmacCause(channelBit);
+    m_ioRegisters[channelBase + 0x00] &= ~0x100u;
+    m_ioRegisters[channelBase + 0x20] = 0;
+}
+
+// Hands m_pendingVif1Transfers to the worker. Transfers that read RAM or
+// the scratchpad directly (not a chain, which was copied at kick time) are
+// copied here, so that later EE writes cannot change what VIF1 reads.
+void PS2Memory::startVif1Job()
+{
+    syncVif1(Vif1SyncReason::Other); // a transfer still in flight ends first
+    std::vector<PendingTransfer> job;
+    job.reserve(m_pendingVif1Transfers.size());
+    for (auto &p : m_pendingVif1Transfers)
+    {
+        if (p.chainData.empty() && p.qwc > 0)
+        {
+            uint32_t srcPhys = 0;
+            try
+            {
+                srcPhys = translateAddress(p.srcAddr);
+            }
+            catch (const std::exception &)
+            {
+                continue; // skipped as the synchronous path skips it
+            }
+            const uint64_t bytes64 = static_cast<uint64_t>(p.qwc) * 16ull;
+            uint32_t bytesLeft = (bytes64 > 0xFFFFFFFFull) ? 0xFFFFFFFFu : static_cast<uint32_t>(bytes64);
+            const uint32_t limit = p.fromScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            const uint8_t *base = p.fromScratchpad ? m_scratchpad : m_rdram;
+            PendingTransfer copy;
+            while (bytesLeft > 0)
+            {
+                if (srcPhys >= limit)
+                    srcPhys = 0;
+                uint32_t chunk = bytesLeft;
+                if (srcPhys + chunk > limit)
+                    chunk = limit - srcPhys;
+                if (chunk == 0)
+                    break;
+                copy.chainData.insert(copy.chainData.end(), base + srcPhys, base + srcPhys + chunk);
+                bytesLeft -= chunk;
+                srcPhys += chunk;
+            }
+            job.push_back(std::move(copy));
+        }
+        else if (!p.chainData.empty())
+        {
+            job.push_back(std::move(p));
+        }
+    }
+    m_pendingVif1Transfers.clear();
+
+    const uint32_t fbrst = m_vu1FbrstProvider ? m_vu1FbrstProvider() : 0u;
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        m_vif1Job = std::move(job);
+        m_vif1JobFbrst = fbrst;
+        m_vif1JobStopValid = false;
+        m_vif1JobReady = true;
+        m_vif1JobDone = false;
+        if (!m_vif1Thread.joinable())
+        {
+            m_vif1Quit = false;
+            m_vif1Thread = std::thread([this]()
+                                       { vif1WorkerLoop(); });
+        }
+    }
+    m_vif1Cv.notify_all();
+    m_vif1InFlight = true;
+    ++m_vif1KickSerial;
+}
+
+void PS2Memory::vif1WorkerLoop()
+{
+    tl_onVif1Worker = true;
+    for (;;)
+    {
+        std::vector<PendingTransfer> job;
+        {
+            std::unique_lock<std::mutex> lock(m_vif1Mutex);
+            m_vif1Cv.wait(lock, [this]()
+                          { return m_vif1JobReady || m_vif1Quit; });
+            if (m_vif1Quit)
+                return;
+            job = std::move(m_vif1Job);
+            m_vif1Job.clear();
+            m_vif1JobReady = false;
+        }
+        try
+        {
+            for (const auto &p : job)
+                processVIF1Data(p.chainData.data(), static_cast<uint32_t>(p.chainData.size()));
+            if (m_gifArbiter)
+                m_gifArbiter->drain();
+        }
+        catch (const std::exception &e)
+        {
+            std::fprintf(stderr, "[vif1-async] VIF1 worker: %s\n", e.what());
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_vif1Mutex);
+            m_vif1JobDone = true;
+        }
+        m_vif1Cv.notify_all();
+    }
+}
+
+void PS2Memory::stopVif1Worker()
+{
+    if (!m_vif1Thread.joinable())
+        return;
+    {
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        m_vif1Cv.wait(lock, [this]()
+                      { return m_vif1JobDone; });
+        m_vif1Quit = true;
+    }
+    m_vif1Cv.notify_all();
+    m_vif1Thread.join();
+    m_vif1InFlight = false;
+}
+
+void PS2Memory::syncVif1(Vif1SyncReason reason)
+{
+    if (!m_vif1InFlight)
+        return;
+    {
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        if (!m_vif1JobDone)
+        {
+            // The EE reached the completion point before the worker
+            // finished: the time it waits is reported below.
+            const auto waitStart = std::chrono::steady_clock::now();
+            m_vif1Cv.wait(lock, [this]()
+                          { return m_vif1JobDone; });
+            m_vif1WaitSeconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - waitStart).count();
+            ++m_vif1Waits;
+        }
+    }
+    m_vif1InFlight = false;
+    if (m_vif1JobStopValid && m_vu1StopSink)
+        m_vu1StopSink(m_vif1JobStopD, m_vif1JobStopT);
+    completeDmaChannel(1u, 0x10009000u);
+    m_vif1Delivered = true;
+
+    ++m_vif1SyncCounts[static_cast<size_t>(reason)];
+    if (++m_vif1Deliveries % 600u == 0u)
+    {
+        const auto &c = m_vif1SyncCounts;
+        std::fprintf(stderr, "[vif1-async] %llu transfers completed at: register %llu, GS register %llu, "
+                             "VU1 memory %llu, EE idle %llu, cycle limit %llu, VBlank %llu, other %llu; the EE "
+                             "waited for the worker %llu times, %.1f ms on average\n",
+                     static_cast<unsigned long long>(m_vif1Deliveries),
+                     static_cast<unsigned long long>(c[0]), static_cast<unsigned long long>(c[1]),
+                     static_cast<unsigned long long>(c[2]), static_cast<unsigned long long>(c[3]),
+                     static_cast<unsigned long long>(c[4]), static_cast<unsigned long long>(c[5]),
+                     static_cast<unsigned long long>(c[6]),
+                     static_cast<unsigned long long>(m_vif1Waits),
+                     m_vif1Waits != 0u ? m_vif1WaitSeconds * 1000.0 / static_cast<double>(m_vif1Waits) : 0.0);
+        m_vif1Waits = 0;
+        m_vif1WaitSeconds = 0.0;
+    }
+}
+
+// The EE registers whose access waits for (and completes) a transfer in
+// flight: everything VIF1 or its output works on, or that shows the end of
+// the transfer. Not: timers, INTC, VIF0 and its DMA channel, the SIF and
+// scratchpad DMA channels, D_PCR and D_STAT writes (a write applies to the
+// status before the completion, as it would on the console).
+void PS2Memory::syncVif1ForIoRegister(uint32_t address, bool write)
+{
+    const bool gifOrVif1 = (address >= 0x10003000u && address < 0x10003800u) ||  // GIF
+                           (address >= 0x10003C00u && address < 0x10004000u) ||  // VIF1
+                           (address >= 0x10005000u && address < 0x10007000u) ||  // VIF1, GIF FIFOs
+                           (address >= 0x10009000u && address < 0x10009100u) ||  // DMA channel 1
+                           (address >= 0x1000A000u && address < 0x1000A100u);    // DMA channel 2
+    const bool dmac = (address == 0x1000E010u && !write) || // D_STAT read
+                      (address == 0x1000E000u && write) ||  // D_CTRL write
+                      address == 0x1000F520u || address == 0x1000F590u; // D_ENABLER/W
+    if (gifOrVif1 || dmac)
+        syncVif1(Vif1SyncReason::Register);
+}
+
+uint32_t PS2Memory::vu1RunFbrst()
+{
+    if (tl_onVif1Worker)
+        return m_vif1JobFbrst;
+    return m_vu1FbrstProvider ? m_vu1FbrstProvider() : 0u;
+}
+
+void PS2Memory::reportVu1Stop(bool stoppedByD, bool stoppedByT)
+{
+    if (tl_onVif1Worker)
+    {
+        m_vif1JobStopValid = true;
+        m_vif1JobStopD = stoppedByD;
+        m_vif1JobStopT = stoppedByT;
+        return;
+    }
+    if (m_vu1StopSink)
+        m_vu1StopSink(stoppedByD, stoppedByT);
+}
