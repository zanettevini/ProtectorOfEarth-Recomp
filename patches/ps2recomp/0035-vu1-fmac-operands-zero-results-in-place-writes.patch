+// writeVfNow / writeAccNow for a value already written in place: only the
+// write sequence (when an older write may be queued) and the pending mark.
+PS2_VU_FORCEINLINE void VU1Interpreter::noteVfWriteNow(uint8_t reg, uint8_t laneMask, uint32_t latency)
+{
+    if (reg == 0u || laneMask == 0u)
+        return;
+    if (m_vfValid != 0u)
+    {
+        const uint64_t sequence = ++m_nextWriteSequence;
+        PS2_VU_UNROLL_LANES
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((laneMask & static_cast<uint8_t>(1u << (3u - component))) != 0u)
+                m_vfLatestWrite[reg][component] = sequence;
+    }
+    if (m_cycle + latency > m_immediatePendingUntil)
+        m_immediatePendingUntil = m_cycle + latency;
+}
+
+PS2_VU_FORCEINLINE void VU1Interpreter::noteAccWriteNow(uint8_t laneMask, uint32_t latency)
+{
+    if (laneMask == 0u)
