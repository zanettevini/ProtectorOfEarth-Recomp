+// The product operands of a product-sum or plain-product instruction for all
+// lanes, read four lanes at a time (for product-sum words what
+// fmacProductOperands gives per lane).
+PS2_VU_FMAC_INLINE void VU1Interpreter::fmacProductOperands4(float *left, float *right) const
+{
+    const uint32_t upper = m_currentUpperInstruction;
+    const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+    const uint8_t special = op >= 0x3Cu ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : 0xFFu;
+    const uint8_t fs = static_cast<uint8_t>((upper >> 11) & 0x1Fu);
+    const uint8_t ft = static_cast<uint8_t>((upper >> 16) & 0x1Fu);
+    float vs[4];
+    ps2_vu1_fmac_detail::normalizeOperands4(m_state.vf[fs], vs);
+    if (op == 0x2Eu || special == 0x2Eu)
+    {
+        // OPMSUB / OPMULA: left = vs.yzxw, right = vt.zxyw
+        float vt[4];
+        ps2_vu1_fmac_detail::normalizeOperands4(m_state.vf[ft], vt);
+        left[0] = vs[1];
+        left[1] = vs[2];
+        left[2] = vs[0];
+        left[3] = vs[3];
+        right[0] = vt[2];
+        right[1] = vt[0];
+        right[2] = vt[1];
+        right[3] = vt[3];
+        return;
+    }
+    std::memcpy(left, vs, sizeof(vs));
+    float broadcastValue = 0.0f;
+    bool broadcastRight = true;
+    const auto bcForm = [](uint32_t o)
+    { return (o >= 0x08u && o <= 0x0Fu) || (o >= 0x18u && o <= 0x1Bu); };
+    const auto qForm = [](uint32_t o)
+    { return o == 0x1Cu || o == 0x21u || o == 0x25u; };
+    const auto iForm = [](uint32_t o)
+    { return o == 0x1Eu || o == 0x23u || o == 0x27u; };
+    if (bcForm(op) || (special != 0xFFu && bcForm(special)))
+        broadcastValue = normalizeOperand(m_state.vf[ft][(bcForm(op) ? op : special) & 3u]);
+    else if (qForm(op) || (special != 0xFFu && qForm(special)))
+        broadcastValue = normalizeOperand(m_state.q);
+    else if (iForm(op) || (special != 0xFFu && iForm(special)))
+        broadcastValue = normalizeOperand(m_state.i);
+    else
+        broadcastRight = false;
+    if (broadcastRight)
+    {
+        right[0] = broadcastValue;
+        right[1] = broadcastValue;
+        right[2] = broadcastValue;
+        right[3] = broadcastValue;
+    }
+    else
+        ps2_vu1_fmac_detail::normalizeOperands4(m_state.vf[ft], right);
+}
