@@ -1025,6 +1085,17 @@
     m_state.vf[0][3] = 1.0f;
     m_state.vi[0] = 0;
 
+    // A pair in the body of a translated block (VU1NativeAccess::blockPair):
+    // no branch, delay slot, E, D or T bit can be pending or start here (the
+    // translator ends blocks before such pairs and the block checks the
+    // state on entry), so what follows reduces to the cycle advance; the
+    // block sets the PC itself (findings/21 s.24).
+    if (blockBody)
+    {
+        advanceOneCycle();
+        return StepResult::Continue;
+    }
+
     uint32_t nextPc = m_state.pc + 8u;
     if (nextPc >= f.codeSize)
         nextPc = 0u;
@@ -1214,6 +1285,90 @@
             { Lower(v, fr.vuData, fr.dataSize, *fr.gs, fr.memory, upperWord); },
             VU1Interpreter::ConstTiming<P>{}, true);
     }
+    // ---- Translated blocks (findings/21 s.24) ---------------------------
+    // A block function runs a straight-line run of pairs: the body pairs
+    // here, one after another without going back to the run loop, then the
+    // last pair (a branch and its delay slot, an E/D/T pair, or simply the
+    // last pair) through its ordinary per-pair function.
+    // A block may start only where the run loop would run its first pair
+    // with no branch, delay slot or end pending.
+    // The run loop's checks before a pair (budget, stop, a due commit, the
+    // end of code memory).
+    static PS2_VU_FORCEINLINE Result loopHead(VU1Interpreter &vu, Frame &frame)
+    {
+        return vu.loopHead(frame);
+    }
+    static PS2_VU_FORCEINLINE bool blockCanEnter(const VU1Interpreter &vu)
+    {
+        return !vu.m_state.branchPending && !vu.m_state.ebit && !vu.m_state.haltAfterDelaySlot;
+    }
+    // Sets the PC the run loop would hold before the pair at `pc` (wrapping
+    // at the end of code memory as the per-pair step does).
+    static PS2_VU_FORCEINLINE void blockSetPc(VU1Interpreter &vu, const Frame &frame, uint32_t pc)
+    {
+        vu.m_state.pc = pc >= frame.codeSize ? 0u : pc;
+    }
+    // One body pair at kPc, as the run loop followed by the per-pair step
+    // would run it, without what cannot happen inside a block:
+    // - the run loop's commit check: the previous pair's cycle advance has
+    //   just committed everything due by this cycle;
+    // - its budget check: the step makes the same one before it executes;
+    // - its end-of-code-memory check: kPc is inside code memory;
+    // - the PC update: only branches (never in a body) read the PC, so it is
+    //   set only when the block leaves early.
+    // The stop request is still checked (a full flag ring can set it). The
+    // first pair skips that too (the run loop has just checked it). The
+    // hazard check reads only the lanes the translator could not settle at
+    // build time (MaskedTiming). Returns false when the run loop would stop
+    // (Break), with the PC at kPc.
+    template <void (*Upper)(VU1Interpreter &), const Pair &P, uint32_t kPc, bool kFirst,
+              uint8_t kU0, uint8_t kU1, uint8_t kL0, uint8_t kL1, uint16_t kVi, uint8_t kAcc>
+    static PS2_VU_FORCEINLINE bool blockPairUpper(VU1Interpreter &vu, Frame &frame)
+    {
+        if constexpr (!kFirst)
+        {
+            if (vu.m_stopRequested) [[unlikely]]
+            {
+                vu.m_state.pc = kPc;
+                return false;
+            }
+        }
+        const uint32_t lowerWord = P.lower;
+        const uint32_t upperWord = P.upper;
+        if (vu.execPairWith(
+                P, frame, [](VU1Interpreter &v)
+                { Upper(v); },
+                [lowerWord, upperWord](VU1Interpreter &v, Frame &fr)
+                { v.execLower(lowerWord, fr.vuData, fr.dataSize, *fr.gs, fr.memory, upperWord); },
+                VU1Interpreter::MaskedTiming<P, kU0, kU1, kL0, kL1, kVi, kAcc>{}, true, true) == Result::Continue) [[likely]]
+            return true;
+        vu.m_state.pc = kPc;
+        return false;
+    }
+    template <void (*Upper)(VU1Interpreter &), LowerFn Lower, const Pair &P, uint32_t kPc, bool kFirst,
+              uint8_t kU0, uint8_t kU1, uint8_t kL0, uint8_t kL1, uint16_t kVi, uint8_t kAcc>
+    static PS2_VU_FORCEINLINE bool blockPairUpperLower(VU1Interpreter &vu, Frame &frame)
+    {
+        if constexpr (!kFirst)
+        {
+            if (vu.m_stopRequested) [[unlikely]]
+            {
+                vu.m_state.pc = kPc;
+                return false;
+            }
+        }
+        const uint32_t upperWord = P.upper;
+        if (vu.execPairWith(
+                P, frame, [](VU1Interpreter &v)
+                { Upper(v); },
+                [upperWord](VU1Interpreter &v, Frame &fr)
+                { Lower(v, fr.vuData, fr.dataSize, *fr.gs, fr.memory, upperWord); },
+                VU1Interpreter::MaskedTiming<P, kU0, kU1, kL0, kL1, kVi, kAcc>{}, true, true) == Result::Continue) [[likely]]
+            return true;
+        vu.m_state.pc = kPc;
+        return false;
+    }
+
     // One upper instruction, inline: called with a constant word, the
     // compiler keeps only that instruction's code.
     static PS2_VU_FORCEINLINE void execUpper(VU1Interpreter &vu, uint32_t instr)
