+// calculatePairReadyCycleConst with only the given read lanes (MaskedTiming).
+template <const VU1Interpreter::DecodedInstructionPair &D, uint8_t kU0, uint8_t kU1, uint8_t kL0, uint8_t kL1, uint16_t kVi, uint8_t kAcc>
+PS2_VU_FORCEINLINE uint64_t VU1Interpreter::calculatePairReadyCycleMasked() const
+{
+    static_assert((kU0 & ~D.upperUsage.vfRead[0].lanes & 0xFu) == 0u && (kU1 & ~D.upperUsage.vfRead[1].lanes & 0xFu) == 0u &&
+                      (kL0 & ~D.lowerUsage.vfRead[0].lanes & 0xFu) == 0u && (kL1 & ~D.lowerUsage.vfRead[1].lanes & 0xFu) == 0u &&
+                      (kVi & ~(D.upperUsage.viRead | D.lowerUsage.viRead)) == 0u &&
+                      (kAcc & ~(D.upperUsage.accRead | D.lowerUsage.accRead) & 0xFu) == 0u,
+                  "MaskedTiming may only drop read lanes");
+    uint64_t ready = m_cycle;
+    if constexpr (D.upperUsage.vfReadCount > 0u)
+        maxVfReady<D.upperUsage.vfRead[0].reg, kU0>(ready);
+    if constexpr (D.upperUsage.vfReadCount > 1u)
+        maxVfReady<D.upperUsage.vfRead[1].reg, kU1>(ready);
+    if constexpr (D.lowerUsage.vfReadCount > 0u)
+        maxVfReady<D.lowerUsage.vfRead[0].reg, kL0>(ready);
+    if constexpr (D.lowerUsage.vfReadCount > 1u)
+        maxVfReady<D.lowerUsage.vfRead[1].reg, kL1>(ready);
+    maxViReady<static_cast<uint16_t>(kVi & 0xFFFEu)>(ready);
+    maxAccReady<kAcc>(ready);
+
+    if constexpr (D.lowerUsage.pipeline == PipelineFdiv)
+        if (m_fdiv.valid)
+            ready = std::max(ready, m_fdiv.readyCycle);
+    if constexpr (D.lowerUsage.pipeline == PipelineEfu)
+        ready = std::max(ready, m_efuResourceReady);
+    if constexpr (D.lowerUsage.waitQ)
+        if (m_fdiv.valid)
+            ready = std::max(ready, m_fdiv.readyCycle);
+    if constexpr (D.lowerUsage.waitP)
+    {
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid)
+                ready = std::max(ready, entry.readyCycle);
+    }
+    if constexpr (D.lowerUsage.pipeline == PipelineXgkick)
+        if (m_xgkick.active)
+            ready = std::max(ready, m_cycle + 1u);
+    return ready;
+}
