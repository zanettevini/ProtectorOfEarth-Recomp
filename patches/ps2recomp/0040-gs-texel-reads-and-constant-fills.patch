+namespace
+{
+    // What WritePixel writes for one pixel when the result cannot depend on
+    // the frame or Z buffer already in memory: no frame read (WritePixel's
+    // frmw is false: no blending, FBMSK, preserved destination alpha or
+    // destination alpha test with a stored alpha) and a Z test of NEVER or
+    // ALWAYS. Then every pixel with the same inputs gets the same writes.
+    // This follows WritePixel step by step for that case; it returns false
+    // when the case does not apply.
+    struct ConstantPixelWrites
+    {
+        bool writeFrame = false;
+        bool writeDepth = false;
+        uint32_t frame = 0u; // the value WritePixel passes to WriteVramUnlocked
+        uint32_t depth = 0u;
+    };
+
+    bool constantPixelWrites(const GSDrawState &state, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog,
+                             ConstantPixelWrites &out)
+    {
+        const auto &ctx = state.context;
+        out = {};
+
+        if (state.prim.fge)
+        {
+            const uint32_t inverseFog = 255u - fog;
+            auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+            {
+                return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+            };
+            r = applyFog(r, state.fogR);
+            g = applyFog(g, state.fogG);
+            b = applyFog(b, state.fogB);
+        }
+
+        const u32 fpsm = ctx.frame.psm;
+        const PixelWriteMask writeMask = classifyAlphaTest(ctx.test, a, static_cast<uint8_t>(fpsm));
+        const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        const bool alphaBlendEnabled = state.prim.abe;
+        const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && fpsm == GS_PSM_CT32;
+        const bool destinationAlphaTestNeedsRead = ((ctx.test >> 14) & 0x1u) != 0u && (fpsm == GS_PSM_CT32 || fpsm == GS_PSM_CT16 || fpsm == GS_PSM_CT16S);
+        const bool frmw = destinationAlphaTestNeedsRead || (writeMask.writesFramebuffer() && ((ctx.frame.fbmsk != 0) || alphaBlendEnabled || preserveDestinationAlpha));
+        if (frmw || ztestMethod == 2u || ztestMethod == 3u)
+            return false;
+
+        if (!writeMask.writesAnything())
+            return true; // WritePixel returns without writing
+        if (!passesDestinationAlphaTest(ctx.test, static_cast<uint8_t>(fpsm), 0u))
+            return true; // tested against 0 when the frame is not read, as in WritePixel
+        if (ztestMethod == 0u)
+            return true; // Z test NEVER
+
+        if (writeMask.writesFramebuffer())
+        {
+            // No blending, FBMSK or preserved alpha here: each needs frmw.
+            if (writeMask.writeAlpha && (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24)
+                a = static_cast<uint8_t>(a | 0x80u);
+            u32 pixel = pack32(r, g, b, a);
+            if (bitsPerPixel(fpsm) == 16)
+                pixel = Rgba8888ToRgba5551(pixel);
+            out.writeFrame = true;
+            out.frame = pixel;
+        }
+        if (writeMask.writeDepth && !ctx.zbuf.zmask)
+        {
+            out.writeDepth = true;
+            out.depth = static_cast<uint32_t>(z);
+        }
+        return true;
+    }
+}
