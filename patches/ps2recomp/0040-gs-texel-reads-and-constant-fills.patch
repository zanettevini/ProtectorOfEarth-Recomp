+    namespace
+    {
+        template <PixelStorageMode M, typename TableT>
+        void readFour(const TableT& table, TexturePageCache& cache, const u8* data, u32 bp, u32 bw,
+                      const u32 (&x)[4], const u32 (&y)[4], u32 (&out)[4])
+        {
+            for (int i = 0; i < 4; ++i)
+                out[i] = PixelStorageTraits<M>::Read(table, data, bp, bw, x[i], y[i], &cache);
+        }
+    }
+
+    void ReadTexture4(TexturePageCache& cache, const u8* data, u32 psm, u32 bp, u32 bw,
+                      const u32 (&x)[4], const u32 (&y)[4], u32 (&out)[4])
+    {
+        switch (static_cast<PixelStorageMode>(psm & 0x3Fu))
+        {
+        case C32: readFour<C32>(PageTableC32, cache, data, bp, bw, x, y, out); return;
+        case C24: readFour<C24>(PageTableC32, cache, data, bp, bw, x, y, out); return;
+        case C16: readFour<C16>(PageTableC16, cache, data, bp, bw, x, y, out); return;
+        case C16S: readFour<C16S>(PageTableC16S, cache, data, bp, bw, x, y, out); return;
+        case P8: readFour<P8>(PageTableP8, cache, data, bp, bw, x, y, out); return;
+        case P4: readFour<P4>(PageTableP4, cache, data, bp, bw, x, y, out); return;
+        case P8H: readFour<P8H>(PageTableC32, cache, data, bp, bw, x, y, out); return;
+        case P4HL: readFour<P4HL>(PageTableC32, cache, data, bp, bw, x, y, out); return;
+        case P4HH: readFour<P4HH>(PageTableC32, cache, data, bp, bw, x, y, out); return;
+        case Z32: readFour<Z32>(PageTableZ32, cache, data, bp, bw, x, y, out); return;
+        case Z24: readFour<Z24>(PageTableZ32, cache, data, bp, bw, x, y, out); return;
+        case Z16: readFour<Z16>(PageTableZ16, cache, data, bp, bw, x, y, out); return;
+        case Z16S: readFour<Z16S>(PageTableZ16S, cache, data, bp, bw, x, y, out); return;
+        default:
+            for (int i = 0; i < 4; ++i)
+                out[i] = 0u;
+            return;
+        }
+    }
