+            alignas(16) float w0s[4], w1s[4], w2s[4];
+            _mm_store_ps(w0s, w0v);
+            _mm_store_ps(w1s, w1v);
+            _mm_store_ps(w2s, w2v);
+            for (int lane = 0; lane < 4; ++lane)
+            {
+                if (covered & (1 << lane))
