+// What WritePixel needs from the draw state that is the same for every
+// pixel of a primitive: buffer bases, formats and the VRAM accessors for
+// them. DrawTriangle and DrawSprite make it once per primitive.
+struct GSCpuBackend::PixelSetup
+{
+    u32 fbp, fbw, fpsm, zbp, zpsm;
+    ReadVramFunc readFrame, readZ;
+    WriteVramFunc writeFrame, writeZ;
+};
+
+GSCpuBackend::PixelSetup GSCpuBackend::MakePixelSetup(const GSDrawState &state) const
+{
+    const auto &ctx = state.context;
+    PixelSetup setup{};
+    setup.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    setup.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    setup.fpsm = ctx.frame.psm;
+    setup.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    setup.zpsm = ctx.zbuf.psm;
+    setup.readFrame = m_readVramFuncs[setup.fpsm & 0x3Fu];
+    setup.readZ = m_readVramFuncs[setup.zpsm & 0x3Fu];
+    setup.writeFrame = m_writeVramFuncs[setup.fpsm & 0x3Fu];
+    setup.writeZ = m_writeVramFuncs[setup.zpsm & 0x3Fu];
+    return setup;
+}
