+// The texture state SampleTexture decodes, once per primitive.
+struct GSCpuBackend::SamplerSetup
+{
+    int texW, texH;
+    uint8_t wrapU, wrapV;
+    uint16_t minU, maxU, minV, maxV;
+    bool indexed;         // T8, T8H, T4, T4HL, T4HH: through the palette cache
+    uint64_t paletteKey;  // the palette cache key of those (CLUT settings, TEXA)
+};
+
+GSCpuBackend::SamplerSetup GSCpuBackend::MakeSamplerSetup(const GSDrawState &state) const
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    SamplerSetup setup{};
+    setup.texW = state.textureWidth;
+    setup.texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    setup.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    setup.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    setup.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    setup.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    setup.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    setup.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    setup.indexed = tex.psm == GS_PSM_T8 || tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4 ||
+                    tex.psm == GS_PSM_T4HL || tex.psm == GS_PSM_T4HH;
+    setup.paletteKey = (static_cast<uint64_t>(tex.cpsm) << 35u) |
+                       (static_cast<uint64_t>(tex.csm) << 27u) |
+                       (static_cast<uint64_t>(tex.csa) << 19u) |
+                       (static_cast<uint64_t>(isFourBitIndexedPsm(tex.psm) ? 1u : 0u) << 18u) |
+                       (static_cast<uint64_t>(isEightBitIndexedPsm(tex.psm) ? 1u : 0u) << 17u) |
+                       (static_cast<uint64_t>(state.texa.aem ? 1u : 0u) << 16u) |
+                       (static_cast<uint64_t>(state.texa.ta1) << 8u) |
+                       static_cast<uint64_t>(state.texa.ta0);
+    return setup;
+}
+
+// The palette cache (m_palette, m_paletteValid) holds LookupCLUT results
+// for one key; a new key empties it. It only memoises LookupCLUT, whose
+// result depends on the CLUT buffer (a CLUT load resets the key) and the
+// key's fields, so emptying it once per primitive instead of at its first
+// sample gives the same texels.
+void GSCpuBackend::BeginSampling(const SamplerSetup &setup)
+{
+    if (setup.indexed && setup.paletteKey != m_paletteKey)
+    {
+        m_paletteKey = setup.paletteKey;
+        m_paletteValid.fill(0u);
+    }
+}
+
 uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t, float q, uint16_t u, uint16_t v)
 {
+    const SamplerSetup setup = MakeSamplerSetup(state);
+    BeginSampling(setup);
+    return SampleTextureWith(setup, state, s, t, q, u, v);
+}
