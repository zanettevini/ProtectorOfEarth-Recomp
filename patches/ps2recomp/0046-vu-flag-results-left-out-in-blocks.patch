+inline void VU1Interpreter::recomputeFlagStickyIssued() noexcept
+{
+    uint32_t sticky = (m_state.status >> 6) & 0xFu;
+    for (uint32_t i = 0; i < m_flagCount; ++i)
+    {
+        const FlagPipelineEntry &entry = m_flagPipeline[(m_flagHead + i) & (kMaxFlagEntries - 1u)];
+        if ((entry.writes & kFlagWritesStatus) != 0u)
+            sticky |= (entry.status >> 6) & 0xFu;
+        if ((entry.writes & kFlagWritesSticky) != 0u)
+            sticky = (entry.status >> 6) & 0xFu;
+    }
+    m_flagStickyIssued = sticky;
+}
