+    // For a block that leaves out flag results (kElide pairs, findings/20
+    // s.28): it may also start only if its body cannot run out of the run's
+    // cycle budget, so that it never stops halfway, between an instruction
+    // whose flag result was left out and the later one whose result replaces
+    // it. kMaxCycles is the translator's bound on the cycles the body takes
+    // (per pair one cycle plus kMaxPipelineLatency, or kMaxXgkickWait for an
+    // XGKICK).
+    template <uint64_t kMaxCycles>
+    static PS2_VU_FORCEINLINE bool blockCanEnterWithin(const VU1Interpreter &vu, const Frame &frame)
+    {
+        return blockCanEnter(vu) && vu.m_cycle + kMaxCycles < frame.budgetEnd;
+    }
+    static constexpr uint32_t kMaxPipelineLatency = VU1Interpreter::kMaxPipelineLatency;
+    static constexpr uint32_t kMaxXgkickWait = VU1Interpreter::kMaxXgkickWait;
+    // For the translator: whether the upper word queues an FMAC flag entry
+    // (MAC and status) when it runs. It does so for every operand value
+    // (the fast and the per-lane flag code both queue one, unless DEST is
+    // empty), so one run with all registers zero tells.
+    static bool upperQueuesFmacFlags(VU1Interpreter &vu, uint32_t word)
+    {
+        vu.reset();
+        vu.execUpper(word);
+        for (uint32_t i = 0; i < vu.m_flagCount; ++i)
+            if ((vu.m_flagPipeline[(vu.m_flagHead + i) & (VU1Interpreter::kMaxFlagEntries - 1u)].writes &
+                 VU1Interpreter::kFlagWritesMac) != 0u)
+                return true;
+        return false;
+    }
