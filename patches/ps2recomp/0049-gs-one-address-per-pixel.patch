+    namespace
+    {
+        // As PixelStorageTraits<psm>::Read/Write compute it.
+        template <PixelStorageMode psm, class Table>
+        u32 ByteAddressOf(const Table& table, u32 bp, u32 bw, u32 x, u32 y)
+        {
+            using Traits = PixelStorageTraits<psm>;
+            const u32 pixel_addr = Traits::Address(table, bp, bw, x, y);
+            const u32 bits = pixel_addr * UnpackedBitWidth(psm) + Traits::BitOffset();
+            return (bits / 8) & (MEMORY_SIZE - sizeof(typename Traits::PackedT));
+        }
+    }
+
+    u32 ByteAddressCT32(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<C32>(PageTableC32, bp, bw, x, y); }
+    u32 ByteAddressCT24(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<C24>(PageTableC32, bp, bw, x, y); }
+    u32 ByteAddressCT16(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<C16>(PageTableC16, bp, bw, x, y); }
+    u32 ByteAddressCT16S(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<C16S>(PageTableC16S, bp, bw, x, y); }
+    u32 ByteAddressZ32(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<Z32>(PageTableZ32, bp, bw, x, y); }
+    u32 ByteAddressZ24(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<Z24>(PageTableZ32, bp, bw, x, y); }
+    u32 ByteAddressZ16(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<Z16>(PageTableZ16, bp, bw, x, y); }
+    u32 ByteAddressZ16S(u32 bp, u32 bw, u32 x, u32 y) { return ByteAddressOf<Z16S>(PageTableZ16S, bp, bw, x, y); }
+
     void WriteCT32(u8* data, u32 bp, u32 bw, u32 x, u32 y, u32 value)
     {
         PixelStorageTraits<C32>::Write(PageTableC32, data, bp, bw, x, y, value);
