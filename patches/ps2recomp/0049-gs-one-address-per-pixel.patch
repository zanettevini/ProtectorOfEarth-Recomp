+	// one Read*/Write* below compute, for the frame and Z formats: a pixel
+	// read and then written computes it once (findings/20 s.30). C32/Z32 and
+	// C24/Z24 hold a 32-bit word there (C24/Z24 use its low 24 bits), the
+	// 16-bit formats a 16-bit one.
+	u32 ByteAddressCT32(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressCT24(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressCT16(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressCT16S(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressZ32(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressZ24(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressZ16(u32 bp, u32 bw, u32 x, u32 y);
+	u32 ByteAddressZ16S(u32 bp, u32 bw, u32 x, u32 y);
+
 	void WriteCT32(u8* data, u32 bp, u32 bw, u32 x, u32 y, u32 value);
 	void WriteZ32(u8* data, u32 bp, u32 bw, u32 x, u32 y, u32 value);
 
--- a/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
@@ -963,8 +963,75 @@
     u32 fbp, fbw, fpsm, zbp, zpsm;
     ReadVramFunc readFrame, readZ;
     WriteVramFunc writeFrame, writeZ;
+    // For the formats whose pixel is one 32- or 16-bit word: the function
+    // that gives its byte address, so a pixel read and then written computes
+    // it once (findings/20 s.30), and how the word is read and written.
+    // kWordNone: another format, read and written through the accessors.
+    enum WordKind : uint8_t
+    {
+        kWordNone,
+        kWord32, // C32, Z32
+        kWord24, // C24, Z24: the low 24 bits; a write keeps the top byte
+        kWord16, // C16, C16S, Z16, Z16S
+    };
+    using AddressFunc = u32 (*)(u32, u32, u32, u32);
+    AddressFunc frameAddress, zAddress;
+    WordKind frameWord, zWord;
 };
 
+namespace
+{
+    // The byte-address function and word kind of a frame or Z format.
+    void pixelWordFor(u32 psm, u32 (*&address)(u32, u32, u32, u32), uint8_t &kind)
+    {
+        using namespace GSMem;
+        switch (psm)
+        {
+        case GS_PSM_CT32: address = ByteAddressCT32; kind = 1u; return;
+        case GS_PSM_CT24: address = ByteAddressCT24; kind = 2u; return;
+        case GS_PSM_CT16: address = ByteAddressCT16; kind = 3u; return;
+        case GS_PSM_CT16S: address = ByteAddressCT16S; kind = 3u; return;
+        case GS_PSM_Z32: address = ByteAddressZ32; kind = 1u; return;
+        case GS_PSM_Z24: address = ByteAddressZ24; kind = 2u; return;
+        case GS_PSM_Z16: address = ByteAddressZ16; kind = 3u; return;
+        case GS_PSM_Z16S: address = ByteAddressZ16S; kind = 3u; return;
+        default: address = nullptr; kind = 0u; return;
+        }
+    }
+
+    // The pixel word at a byte address, as the Read accessor of its format
+    // returns it, and its write, as the Write accessor makes it.
+    PS2_GS_FORCEINLINE u32 loadPixelWord(const uint8_t *vram, u32 address, uint8_t kind)
+    {
+        if (kind == 3u)
+        {
+            uint16_t v;
+            std::memcpy(&v, vram + address, sizeof(v));
+            return v;
+        }
+        u32 v;
+        std::memcpy(&v, vram + address, sizeof(v));
+        return kind == 2u ? (v & 0x00FFFFFFu) : v;
+    }
+
+    PS2_GS_FORCEINLINE void storePixelWord(uint8_t *vram, u32 address, uint8_t kind, u32 value)
+    {
+        if (kind == 3u)
+        {
+            const uint16_t v = static_cast<uint16_t>(value);
+            std::memcpy(vram + address, &v, sizeof(v));
+            return;
+        }
+        if (kind == 2u)
+        {
+            u32 old;
+            std::memcpy(&old, vram + address, sizeof(old));
+            value = (old & 0xFF000000u) | (value & 0x00FFFFFFu);
+        }
+        std::memcpy(vram + address, &value, sizeof(value));
+    }
+}
+
 GSCpuBackend::PixelSetup GSCpuBackend::MakePixelSetup(const GSDrawState &state) const
 {
