-              uint8_t kU0, uint8_t kU1, uint8_t kL0, uint8_t kL1, uint16_t kVi, uint8_t kAcc, bool kElide = false>
+              uint8_t kU0, uint8_t kU1, uint8_t kL0, uint8_t kL1, uint16_t kVi, uint8_t kAcc, bool kElide = false,
+              bool kZeroWrite = true>
     static PS2_VU_FORCEINLINE bool blockPairUpperLower(VU1Interpreter &vu, Frame &frame)
     {
