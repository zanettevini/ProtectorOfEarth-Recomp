-                VU1Interpreter::MaskedTiming<P, kU0, kU1, kL0, kL1, kVi, kAcc>{}, true, true, true) == Result::Continue) [[likely]]
+                VU1Interpreter::MaskedTiming<P, kU0, kU1, kL0, kL1, kVi, kAcc>{}, true, true, true, kZeroWrite) == Result::Continue) [[likely]]
