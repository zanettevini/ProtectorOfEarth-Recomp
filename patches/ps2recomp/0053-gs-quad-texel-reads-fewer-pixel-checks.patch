 namespace GSMem
 {
     using C32Traits  = PixelStorageTraits<C32>;
@@ -266,6 +274,87 @@
         }
     }
 
+    namespace
+    {
+        // PixelStorageTraits<M>::Read for a texel whose page-local address
+        // is already known: the same steps after Address().
+        template <PixelStorageMode M>
+        PS2_GS_MEMORY_INLINE u32 readAtPixel(TexturePageCache& cache, const u8* data, u32 pixel_addr)
+        {
+            using Traits = PixelStorageTraits<M>;
+            using PackedT = typename Traits::PackedT;
+            const u32 bits = pixel_addr * UnpackedBitWidth(M) + Traits::BitOffset();
+            const u32 byte_addr = (bits / 8) & (MEMORY_SIZE - sizeof(PackedT));
+            const u32 shift = bits % 8;
+            const u8* source = cache.Resolve(data, byte_addr);
+            PackedT v;
+            std::memcpy(&v, source, sizeof(PackedT));
+            switch (M)
+            {
+            case C24:
+            case Z24:
+                return v & 0x00FFFFFF;
+            case P4:
+            case P4HL:
+            case P4HH:
+                return (v >> shift) & 0x0F;
+            default:
+                return v;
+            }
+        }
+
+        // The four texels of a bilinear sample: Address() split into the
+        // part of each row (v) and of each column (u), as PageId and the
+        // page table compute them.
+        template <PixelStorageMode M, typename TableT>
+        void readQuad(const TableT& table, TexturePageCache& cache, const u8* data, u32 bp, u32 bw,
+                      u32 u0, u32 u1, u32 v0, u32 v1, u32 (&out)[4])
+        {
+            using Traits = PixelStorageTraits<M>;
+            constexpr auto page_extent = Traits::PageExtent();
+            constexpr u32 blocks = static_cast<u32>(Traits::BlocksPerPage());
+            constexpr u32 pixels_per_page = static_cast<u32>(Traits::PixelsPerPage());
+            const u32 base_page = bp / blocks;
+            const auto& pageTable = table[bp % blocks];
+            const u32 rowPages = (bw * 64) / page_extent.x;
+            const u32 row0 = base_page + (v0 / page_extent.y) * rowPages;
+            const u32 row1 = base_page + (v1 / page_extent.y) * rowPages;
+            const u32 col0 = u0 / page_extent.x;
+            const u32 col1 = u1 / page_extent.x;
+            const u32 y0 = v0 % page_extent.y, y1 = v1 % page_extent.y;
+            const u32 x0 = u0 % page_extent.x, x1 = u1 % page_extent.x;
+            out[0] = readAtPixel<M>(cache, data, (row0 + col0) * pixels_per_page + pageTable[y0][x0]);
+            out[1] = readAtPixel<M>(cache, data, (row0 + col1) * pixels_per_page + pageTable[y0][x1]);
+            out[2] = readAtPixel<M>(cache, data, (row1 + col0) * pixels_per_page + pageTable[y1][x0]);
+            out[3] = readAtPixel<M>(cache, data, (row1 + col1) * pixels_per_page + pageTable[y1][x1]);
+        }
+    }
+
+    void ReadTextureQuad(TexturePageCache& cache, const u8* data, u32 psm, u32 bp, u32 bw,
+                         u32 u0, u32 u1, u32 v0, u32 v1, u32 (&out)[4])
+    {
+        switch (static_cast<PixelStorageMode>(psm & 0x3Fu))
+        {
+        case C32: readQuad<C32>(PageTableC32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case C24: readQuad<C24>(PageTableC32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case C16: readQuad<C16>(PageTableC16, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case C16S: readQuad<C16S>(PageTableC16S, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case P8: readQuad<P8>(PageTableP8, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case P4: readQuad<P4>(PageTableP4, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case P8H: readQuad<P8H>(PageTableC32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case P4HL: readQuad<P4HL>(PageTableC32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case P4HH: readQuad<P4HH>(PageTableC32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case Z32: readQuad<Z32>(PageTableZ32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case Z24: readQuad<Z24>(PageTableZ32, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case Z16: readQuad<Z16>(PageTableZ16, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        case Z16S: readQuad<Z16S>(PageTableZ16S, cache, data, bp, bw, u0, u1, v0, v1, out); return;
+        default:
+            for (int i = 0; i < 4; ++i)
+                out[i] = 0u;
+            return;
+        }
+    }
+
     void ReadTexture4(TexturePageCache& cache, const u8* data, u32 psm, u32 bp, u32 bw,
                       const u32 (&x)[4], const u32 (&y)[4], u32 (&out)[4])
     {
