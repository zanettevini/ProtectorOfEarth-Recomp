+
+// PDIVBW: each word of rs divided by the signed halfword rt.h0; quotient to LO.wn, remainder to HI.wn.
+static inline void ps2_mmi_pdivbw(R5900Context *ctx, int rs, int rt)
+{
+    const Ps2GprWords s = Ps2LoadGprWords(ctx, rs);
+    const Ps2GprWords t = Ps2LoadGprWords(ctx, rt);
+    const int32_t divisor = static_cast<int32_t>(Ps2GprHalf(t, 0));
+    Ps2HiLoWords v = Ps2LoadHiLo(ctx);
+    for (int n = 0; n < 4; ++n)
+    {
+        const int32_t a = static_cast<int32_t>(s.w[n]);
+        if (s.w[n] == 0x80000000u && divisor == -1)
+        {
+            v.lo[n] = 0x80000000u;
+            v.hi[n] = 0;
+        }
+        else if (divisor != 0)
+        {
+            v.lo[n] = static_cast<uint32_t>(a / divisor);
+            v.hi[n] = static_cast<uint32_t>(a % divisor);
+        }
+        else
+        {
+            v.lo[n] = (a < 0) ? 1u : 0xFFFFFFFFu;
+            v.hi[n] = static_cast<uint32_t>(a);
+        }
+    }
+    Ps2StoreHiLo(ctx, v);
+}
 
 // FPU (COP1) operations
 #define FPU_SET_ACC(ctx, res) (ctx->f_acc = res)
