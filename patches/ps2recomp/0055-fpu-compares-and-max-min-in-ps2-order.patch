+// C.EQ/C.LT/C.LE and MAX.S/MIN.S order PS2 floats by sign and magnitude of their bits, so the
+// exponent-255 values (0x7F800000 and up, which the host reads as Inf or NaN) are ordinary large
+// numbers. The compares also count an exponent-0 value as zero, whatever its mantissa (PCSX2
+// fpuDouble; the PS2 format above); MAX.S/MIN.S return one operand's bits unchanged (PCSX2 fp_max/fp_min).
+inline int64_t ps2_fcompare_key(float x)
+{
+    const uint32_t b = std::bit_cast<uint32_t>(x);
+    if ((b & PS2_FLOAT_EXP_MASK) == 0u)
+        return 0;
+    const int64_t magnitude = static_cast<int64_t>(b & 0x7FFFFFFFu);
+    return (b & PS2_FLOAT_SIGN_MASK) ? -magnitude : magnitude;
+}
+
+inline float ps2_fmax(float a, float b)
+{
+    const int32_t ia = std::bit_cast<int32_t>(a);
+    const int32_t ib = std::bit_cast<int32_t>(b);
+    const int32_t r = (ia < 0 && ib < 0) ? (ia < ib ? ia : ib) : (ia > ib ? ia : ib);
+    return std::bit_cast<float>(r);
+}
+
+inline float ps2_fmin(float a, float b)
+{
+    const int32_t ia = std::bit_cast<int32_t>(a);
+    const int32_t ib = std::bit_cast<int32_t>(b);
+    const int32_t r = (ia < 0 && ib < 0) ? (ia > ib ? ia : ib) : (ia < ib ? ia : ib);
+    return std::bit_cast<float>(r);
+}
+
