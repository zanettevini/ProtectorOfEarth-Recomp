+// VU0 macro mode DIV/SQRT/RSQRT, as PCSX2's VU interpreter (pcsx2/VUops.cpp _vuDIV, _vuSQRT,
+// _vuRSQRT) and this runtime's own VU interpreter: operands through vuDouble (exponent 0 -> +-0,
+// exponent 255 -> +-0x7F7FFFFF), a zero divisor gives +-0x7F7FFFFF with the sign of fs xor ft
+// (RSQRT of 0 by 0: +-0), the radicand's sign is ignored, and the result goes through vuDouble again.
+inline float ps2_vu_double(uint32_t bits)
+{
+    switch (bits & 0x7F800000u)
+    {
+    case 0u:
+        bits &= 0x80000000u;
+        break;
+    case 0x7F800000u:
+        bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+        break;
+    default:
+        break;
+    }
+    return std::bit_cast<float>(bits);
+}
+
+inline uint32_t ps2_vu_lane_bits(__m128 v, int lane)
+{
+    alignas(16) uint32_t words[4];
+    _mm_store_ps(reinterpret_cast<float *>(words), v);
+    return words[lane & 3];
+}
+
+inline float ps2_vu0_div(__m128 vfs, int fsf, __m128 vft, int ftf)
+{
+    const uint32_t sBits = ps2_vu_lane_bits(vfs, fsf);
+    const uint32_t tBits = ps2_vu_lane_bits(vft, ftf);
+    const float fs = ps2_vu_double(sBits);
+    const float ft = ps2_vu_double(tBits);
+    if (ft == 0.0f)
+        return std::bit_cast<float>(((sBits ^ tBits) & 0x80000000u) | 0x7F7FFFFFu);
+    return ps2_vu_double(std::bit_cast<uint32_t>(fs / ft));
+}
+
+inline float ps2_vu0_sqrt(__m128 vft, int ftf)
+{
+    const float ft = ps2_vu_double(ps2_vu_lane_bits(vft, ftf));
+    return ps2_vu_double(std::bit_cast<uint32_t>(std::sqrt(std::fabs(ft))));
+}
+
+inline float ps2_vu0_rsqrt(__m128 vfs, int fsf, __m128 vft, int ftf)
+{
+    const uint32_t sBits = ps2_vu_lane_bits(vfs, fsf);
+    const uint32_t tBits = ps2_vu_lane_bits(vft, ftf);
+    const float fs = ps2_vu_double(sBits);
+    const float ft = ps2_vu_double(tBits);
+    const uint32_t sign = (sBits ^ tBits) & 0x80000000u;
+    if (ft == 0.0f)
+        return std::bit_cast<float>(fs != 0.0f ? (sign | 0x7F7FFFFFu) : sign);
+    return ps2_vu_double(std::bit_cast<uint32_t>(fs / std::sqrt(std::fabs(ft))));
+}
