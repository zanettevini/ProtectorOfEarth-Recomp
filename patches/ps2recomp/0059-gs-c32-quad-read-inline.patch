+    // readAtPixel and readQuad are in ps2_gs_memory.h (namespace detail), so
+    // the sampler can read C32 quads inline (ReadTextureQuadC32).
+    using detail::readQuad;
 
     void ReadTextureQuad(TexturePageCache& cache, const u8* data, u32 psm, u32 bp, u32 bw,
                          u32 u0, u32 u1, u32 v0, u32 v1, u32 (&out)[4])
