From: Protector of Earth Recomp
Subject: [PATCH] GS: bitsPerPixel as a table lookup

What it is for:
  Per-pixel work of the software rasteriser, which limits Protector of
  Earth Recomp's frame rate in busy scenes.

The changes:
  - GSInternal::bitsPerPixel (ps2_gs_common.h) maps a PSM to its bits per
    pixel with a 256-entry constexpr table built from the same cases (16
    for CT16/CT16S/Z16/Z16S, 8 for T8/T8H, 4 for T4/T4HL/T4HH, 32 for all
    other values) instead of a switch. WritePixelWith asks it for every
    pixel (16-bit frame conversions), and the switch's dispatch was 0.23 G
    of the measure below.
  Same results bit for bit.

How it was checked:
  ben10_gs_replay --sync: the same hashes as before on the first level's
  recording (35 points and the end) and the six random recordings; 6
  bands give the same hashes. ps2xTest 454/454. Instructions for the
  first 60,000 records of the level recording: 10.30 G -> 10.13 G
  (findings/20 s.40).

--- a/ps2xRuntime/include/runtime/gs/ps2_gs_common.h
+++ b/ps2xRuntime/include/runtime/gs/ps2_gs_common.h
@@ -2,35 +2,27 @@
 #define PS2_GS_COMMON_H
 
 #include "runtime/gs/gs_types.h"
+#include <array>
 #include <cstdint>
 
 namespace GSInternal
 {
+// Bits per pixel of a PSM: 16 for CT16/CT16S/Z16/Z16S, 8 for T8/T8H, 4 for
+// T4/T4HL/T4HH, 32 for everything else (CT32, CT24, Z32, Z24 and unknown
+// values). A table rather than a switch: the rasteriser asks this for every
+// pixel it writes (findings/20 s.40).
 static inline uint32_t bitsPerPixel(uint8_t psm)
 {
-    switch (psm)
+    static constexpr std::array<uint8_t, 256> kBits = []
     {
-    case GS_PSM_CT32:
-    case GS_PSM_Z32:
-        return 32;
-    case GS_PSM_CT24:
-    case GS_PSM_Z24:
-        return 32;
-    case GS_PSM_CT16:
-    case GS_PSM_CT16S:
-    case GS_PSM_Z16:
-    case GS_PSM_Z16S:
-        return 16;
-    case GS_PSM_T8:
-    case GS_PSM_T8H:
-        return 8;
-    case GS_PSM_T4:
-    case GS_PSM_T4HL:
-    case GS_PSM_T4HH:
-        return 4;
-    default:
-        return 32;
-    }
+        std::array<uint8_t, 256> bits{};
+        bits.fill(32u);
+        bits[GS_PSM_CT16] = bits[GS_PSM_CT16S] = bits[GS_PSM_Z16] = bits[GS_PSM_Z16S] = 16u;
+        bits[GS_PSM_T8] = bits[GS_PSM_T8H] = 8u;
+        bits[GS_PSM_T4] = bits[GS_PSM_T4HL] = bits[GS_PSM_T4HH] = 4u;
+        return bits;
+    }();
+    return kBits[psm];
 }
 
 static inline uint32_t fbStride(uint32_t fbw, uint8_t psm)
